page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
  font-family:
    -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  width: auto;
  min-width: 0;
  max-width: 100%;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1.2;
  font-size: 28rpx;
}

button::after {
  border: 0;
}
