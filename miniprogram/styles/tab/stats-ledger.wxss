/* Stats page refresh */
.stats-page {
  position: relative;
  background:
    radial-gradient(
      circle at 84% 6%,
      rgba(255, 255, 255, 0.96) 0,
      rgba(255, 255, 255, 0) 230rpx
    ),
    radial-gradient(
      circle at 72% 20%,
      rgba(255, 122, 0, 0.055) 0,
      rgba(255, 122, 0, 0) 220rpx
    ),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.stats-page .brand-row {
  display: none;
}

.ledger-hero {
  margin-top: 8rpx;
  padding: 0;
  overflow: visible;
  background: transparent;
}

.budget-panel,
.calendar-card,
.recent-card,
.category-chip {
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 48rpx rgba(255, 122, 0, 0.05);
}

.budget-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.budget-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff6500;
}

.spend-total {
  margin-top: 18rpx;
  color: #111827;
  font-size: 64rpx;
  font-weight: 950;
  line-height: 1;
  letter-spacing: -1rpx;
}

.spend-sub {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 650;
}

.budget-split {
  width: 100%;
  height: 0;
  margin: 28rpx 0 22rpx;
  border-top: 2rpx dashed rgba(17, 24, 39, 0.14);
}

.remain-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.remain-total {
  color: #ff6500;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1;
}

.remain-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 74rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 800;
  background: #f3f4f6;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hero-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  padding: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  box-shadow: 0 14rpx 28rpx rgba(255, 101, 0, 0.2);
}

.hero-add::after,
.budget-set::after {
  border: 0;
}

.budget-set {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 188rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 72rpx;
  background: #fff0e5;
  box-shadow: inset 0 0 0 1rpx rgba(255, 101, 0, 0.12);
}

.calendar-card {
  padding: 26rpx 24rpx;
}

.calendar-title {
  background: transparent;
  color: #111827;
  font-size: 31rpx;
}

.month-arrow {
  background: #f8fafc;
  color: #111827;
}

.calendar-total {
  color: #ff6500;
  background: #fff0e5;
}

.calendar-day {
  height: 82rpx;
  border-radius: 20rpx;
  background: transparent;
}

.calendar-day.has-amount,
.calendar-day.high {
  background: #fff7f0;
}

.calendar-day.selected {
  background: linear-gradient(180deg, #ff8a1f 0%, #ff6500 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 101, 0, 0.22);
}

.month-trend {
  display: none;
}

.recent-card {
  grid-template-columns: 66rpx minmax(0, 1fr) minmax(82rpx, auto) 108rpx;
  min-height: 96rpx;
  padding: 20rpx;
  border-radius: 30rpx;
}

.recent-icon {
  background: #fff0e5;
  color: #ff6500;
}

.recent-title {
  color: #111827;
  font-size: 27rpx;
  font-weight: 900;
}

.recent-amount {
  color: #111827;
}

.recent-meta,
.chip-head {
  color: #7d8593;
}

.chip-amount {
  color: #111827;
}

.tool-button {
  background: #fff0e5;
  color: #ff6500;
}

.category-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 340px) {
  .spend-total {
    font-size: 54rpx;
  }

  .remain-total {
    font-size: 44rpx;
  }

  .hero-add {
    font-size: 24rpx;
  }

  .budget-set {
    width: 160rpx;
    font-size: 24rpx;
  }
}
/* Expense hero final alignment: keep large numbers, ring and full mascot from crowding. */
.stats-page .ledger-hero {
  margin-bottom: 18rpx;
}

.stats-page .budget-panel {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 352rpx;
  padding: 40rpx 268rpx 34rpx 40rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 94% 88%, rgba(255, 169, 78, 0.26) 0, rgba(255, 169, 78, 0) 220rpx),
    radial-gradient(circle at 76% 32%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 210rpx),
    rgba(255, 255, 255, 0.88);
}

.stats-page .budget-left {
  position: relative;
  z-index: 5;
  flex: 0 0 244rpx;
  width: 244rpx;
  min-width: 0;
}

.stats-page .budget-tag {
  gap: 10rpx;
  font-size: 27rpx;
  line-height: 1.15;
}

.stats-page .spend-total {
  max-width: 252rpx;
  margin-top: 18rpx;
  font-size: 56rpx;
  line-height: 0.96;
  white-space: nowrap;
}

.stats-page .spend-sub {
  margin-top: 18rpx;
  font-size: 25rpx;
  white-space: nowrap;
}

.stats-page .budget-split {
  width: 218rpx;
  margin: 16rpx 0 18rpx;
}

.stats-page .remain-row {
  margin-top: 12rpx;
  gap: 12rpx;
}

.stats-page .remain-total {
  font-size: 44rpx;
  line-height: 1;
  white-space: nowrap;
}

.stats-page .remain-pill {
  min-width: 58rpx;
  height: 34rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}

.stats-page .hero-actions {
  margin-top: 18rpx;
}

@media (max-width: 340px) {
  .stats-page .budget-panel {
    min-height: 318rpx;
    padding: 34rpx 216rpx 30rpx 34rpx;
  }

  .stats-page .budget-left {
    flex-basis: 214rpx;
    width: 214rpx;
  }

  .stats-page .spend-total {
    max-width: 218rpx;
    font-size: 48rpx;
  }

  .stats-page .spend-sub {
    font-size: 22rpx;
  }

  .stats-page .budget-split {
    width: 190rpx;
  }

  .stats-page .remain-total {
    font-size: 38rpx;
  }

  .stats-page .ring-box {
    right: 148rpx;
    top: 96rpx;
    transform: none;
    z-index: 5;
  }

  .stats-page .budget-ring {
    width: 176rpx;
    height: 176rpx;
  }

  .stats-page .ring-inner {
    width: 124rpx;
    height: 124rpx;
  }

  .stats-page .ring-value {
    font-size: 38rpx;
  }

  .stats-page .ring-label {
    font-size: 17rpx;
  }

  .stats-page .budget-duck {
    right: -20rpx;
    bottom: -16rpx;
    width: 238rpx;
    height: 270rpx;
  }
}

/* Ring/duck refinement: larger ring overlays coin edge. */
.stats-page .ring-box {
  position: absolute;
  right: 188rpx;
  top: 104rpx;
  transform: none;
  z-index: 5;
}

.stats-page .budget-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 212rpx;
  height: 212rpx;
  border-radius: 50%;
}

.stats-page .ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 148rpx;
  height: 148rpx;
  padding: 4rpx 0 0;
  border-radius: 50%;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 0 0 2rpx #ffffff;
}

.stats-page .ring-value,
.stats-page .ring-label {
  margin: 0;
  transform: translateY(0);
}

.stats-page .ring-value {
  color: #ff6500;
  font-size: 46rpx;
  line-height: 1;
}

.stats-page .ring-label {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.1;
  white-space: nowrap;
}

.stats-page .budget-duck {
  position: absolute;
  right: -42rpx;
  bottom: -22rpx;
  z-index: 3;
  width: 318rpx;
  height: 340rpx;
  pointer-events: none;
}

/* Opaque ring track masks coin edge even at 0% usage. */

@media (max-width: 340px) {
  .stats-page .ring-box {
    right: 148rpx;
    top: 92rpx;
    transform: none;
    z-index: 5;
  }

  .stats-page .budget-duck {
    right: -42rpx;
    bottom: -18rpx;
    z-index: 3;
    width: 258rpx;
    height: 286rpx;
  }
}
