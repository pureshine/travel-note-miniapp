  position: absolute;
  top: 0;
  right: 300rpx;
  bottom: 0;
  z-index: 2;
  width: 160rpx;
  background: linear-gradient(
    90deg,
    #fff4df 0%,
    rgba(255, 244, 223, 0.9) 54%,
    rgba(255, 244, 223, 0) 100%
  );
  content: "";
  pointer-events: none;
}

.profile-page .invite-bg-duck {
  top: 0;
  right: -28rpx;
  width: 390rpx;
  height: 100%;
  opacity: 0.96;
}

.profile-page .card-head {
  position: relative;
  z-index: 4;
  max-width: 420rpx;
}

.profile-page .sync-title {
  color: #5a270f;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
  white-space: nowrap;
}

.profile-page .sync-desc {
  margin-top: 16rpx;
  color: #7b5b48;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
}

.profile-page .sync-tip,
.profile-page .invite-strip,
.profile-page .sync-badge {
  display: none;
}

.profile-page .sync-card .soft-action.full,
.profile-page .sync-card .share-action {
  position: relative;
  z-index: 5;
  width: 224rpx;
  height: 66rpx;
  min-height: 66rpx;
  margin: 32rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 66rpx;
  background: linear-gradient(135deg, #ff921c 0%, #ff6200 100%);
  box-shadow: 0 14rpx 28rpx rgba(255, 101, 0, 0.2);
}

.profile-page .sync-card .share-action {
  margin-top: 18rpx;
  color: #ff6500;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.16);
}

.profile-page .sync-card.has-members .member-row {
  position: relative;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 388rpx;
  min-height: 62rpx;
  margin-top: 30rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.16),
    0 10rpx 20rpx rgba(255, 122, 0, 0.08);
}

.profile-page .sync-card.has-members .member-label {
  min-width: 58rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 36rpx;
  background: #fff0bf;
}

.profile-page .sync-card.has-members .member-names {
  max-width: 274rpx;
  color: #5d3828;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1;
}

@media (max-width: 340px) {
  .profile-page .sync-card {
    height: 226rpx;
    min-height: 226rpx;
    padding: 34rpx 28rpx 24rpx;
  }

  .profile-page .sync-title {
    font-size: 32rpx;
  }

  .profile-page .sync-desc {
    font-size: 22rpx;
  }

  .profile-page .invite-bg-duck {
    right: -58rpx;
    width: 318rpx;
  }

  .profile-page .sync-card::after {
    right: 220rpx;
    width: 118rpx;
  }

  .profile-page .sync-card .soft-action.full,
  .profile-page .sync-card .share-action {
    width: 188rpx;
    height: 58rpx;
    min-height: 58rpx;
    font-size: 23rpx;
    line-height: 58rpx;
  }
}
