/* Profile tab polish — single source (page wxss keeps setup sheet only). */

.pf-tool-grid {
  display: block;
  margin-top: 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
}

.pf-tool-card {
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  column-gap: 18rpx;
  align-items: center;
  padding: 28rpx 26rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.pf-tool-card + .pf-tool-card {
  border-top: 1rpx solid rgba(226, 232, 240, 0.86);
}

.pf-tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  grid-row: span 2;
  border-radius: 20rpx;
  background: #f1f5f9;
  color: #4b5563;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.pf-tool-title {
  margin-top: 0;
  color: #111827;
  font-size: 30rpx;
}

.pf-tool-desc {
  color: #7d8593;
  font-weight: 400;
  font-size: 22rpx;
  line-height: 1.4;
}

/* Profile reference pass: soften hero/stat seam and restore invite banner proportions. */
.pf-page {
  position: relative;
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 84% 6%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 230rpx),
    radial-gradient(circle at 72% 20%, rgba(255, 122, 0, 0.055) 0, rgba(255, 122, 0, 0) 220rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f7fa 42%, #eef4fb 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.pf-nav {
  z-index: 1000;
  height: 76rpx;
}

.pf-nav-logo {
  width: 310rpx;
  height: 76rpx;
  transform: none;
}

.pf-hero {
  position: relative;
  min-height: 410rpx;
  margin: 0 -10rpx 0;
  padding: 28rpx 24rpx 0 28rpx;
  overflow: visible;
  border-radius: 0;
  background:
    radial-gradient(circle at 78% 66%, rgba(199, 208, 222, 0.34) 0, rgba(199, 208, 222, 0) 250rpx),
    linear-gradient(90deg, rgba(251, 253, 255, 0) 0%, #f8fbff 49%, #f0f4f9 100%);
  box-shadow: none;
}

.pf-hero.is-guest {
  min-height: 400rpx;
  padding-bottom: 28rpx;
}

.pf-hero-duck {
  position: absolute;
  left: -20rpx;
  bottom: 2rpx;
  z-index: 2;
  width: 430rpx;
  height: 410rpx;
  object-fit: contain;
}

/* Profile hero copy redesign: reserve enough room for the full location text. */
.pf-topline {
  position: relative;
  z-index: 3;
  width: calc(100% - 318rpx);
  max-width: 334rpx;
  min-width: 0;
  min-height: 286rpx;
  margin-left: 318rpx;
  padding-top: 88rpx;
  padding-right: 4rpx;
  box-sizing: border-box;
  align-items: flex-start;
}

.pf-copy {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.pf-copy.is-guest {
  gap: 18rpx;
  padding-bottom: 12rpx;
}

.pf-copy.is-guest .pf-location {
  margin-top: 0;
}

.pf-copy.is-guest .pf-record-pill {
  margin-top: 0;
}

.pf-login-box {
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.pf-login-wrap {
  position: relative;
  display: inline-flex;
  align-self: flex-start;
  max-width: 100%;
}

.pf-login-face {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 10rpx 24rpx rgba(255, 122, 0, 0.1),
    inset 0 0 0 2rpx rgba(255, 154, 31, 0.22);
  pointer-events: none;
}

.pf-login-hit {
  position: absolute;
  inset: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: 0;
}

.pf-login-hit::after {
  border: 0;
}

.pf-login-ico {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #07c160;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  background: #e9f9ef;
}

.pf-login-text {
  overflow: hidden;
  color: #ff6500;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pf-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  gap: 16rpx;
}

.pf-name {
  flex: 0 1 auto;
  max-width: 100%;
  color: #1a1a1a;
  font-size: 50rpx;
  font-weight: 850;
  line-height: 1.08;
}

.pf-location {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 100%;
  gap: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pf-loc-icon {
  position: relative;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 26rpx;
  overflow: hidden;
  color: transparent;
}

.pf-loc-icon::before {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 17rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  background: #6b7280;
  content: "";
  transform: rotate(-45deg);
}

.pf-loc-icon::after {
  position: absolute;
  top: 7rpx;
  left: 9rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #f8fbff;
  content: "";
}

.pf-record-pill {
  display: inline-flex;
  flex-wrap: nowrap;
  align-items: center;
  align-self: flex-start;
  max-width: 100%;
  min-width: 0;
  height: 52rpx;
  margin-top: 24rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(107, 114, 128, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #666666;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.035);
  box-sizing: border-box;
}

.pf-record-copy {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.pf-record-text {
  color: #666666;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
}

.pf-record-star {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
  background: #fff2c9;
  color: #ffb400;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.pf-record-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20rpx;
  color: #ff6b00;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1;
  transform: translateY(2rpx);
}

/* Profile reference pass: soften hero/stat seam and restore invite banner proportions. */
.pf-hero {
  background:
    radial-gradient(
      ellipse at 82% 91%,
      rgba(202, 211, 224, 0.32) 0,
      rgba(202, 211, 224, 0.32) 24%,
      rgba(202, 211, 224, 0) 25%
    ),
    radial-gradient(
      ellipse at 96% 92%,
      rgba(219, 225, 235, 0.42) 0,
      rgba(219, 225, 235, 0.42) 30%,
      rgba(219, 225, 235, 0) 31%
    ),
    radial-gradient(circle at 78% 66%, rgba(199, 208, 222, 0.26) 0, rgba(199, 208, 222, 0) 252rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fc 70%, #edf2f8 100%);
}

.pf-hero::after {
  right: -86rpx;
  bottom: -56rpx;
  width: 480rpx;
  height: 210rpx;
  border-radius: 58% 42% 0 0;
  background:
    radial-gradient(
      ellipse at 50% 100%,
      rgba(190, 201, 216, 0.2) 0,
      rgba(190, 201, 216, 0.2) 46%,
      rgba(190, 201, 216, 0) 47%
    ),
    radial-gradient(
      ellipse at 83% 98%,
      rgba(213, 221, 233, 0.4) 0,
      rgba(213, 221, 233, 0.4) 54%,
      rgba(213, 221, 233, 0) 55%
    );
  filter: blur(1rpx);
}

/* Overview stats — left-aligned, sync column wider */
.pf-overview {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: minmax(0, 0.86fr) minmax(0, 0.86fr) minmax(0, 1.28fr);
  gap: 0;
  margin: -54rpx 0 0;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.035),
    0 18rpx 64rpx rgba(17, 24, 39, 0.045);
}

.pf-overview.is-guest {
  margin-top: -24rpx;
}

.pf-stat {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  min-width: 0;
  min-height: 144rpx;
  padding: 20rpx 12rpx 20rpx 18rpx;
  box-sizing: border-box;
}

.pf-stat + .pf-stat {
  border-left: 1rpx solid #e6ebf2;
}

.is-sync {
  padding-right: 16rpx;
}

.pf-stat-icon {
  display: flex;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: flex-start;
  width: 58rpx;
  height: 58rpx;
}

.pf-stat-pic {
  width: 58rpx;
  height: 58rpx;
}

.pf-stat-copy {
  flex: 1;
  min-width: 0;
}

.pf-stat-val {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.08;
  white-space: nowrap;
}

.pf-stat-val.is-compact {
  font-size: 26rpx;
}

.pf-stat-val.is-time {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
}

.pf-stat-title {
  margin-top: 6rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.pf-stat-desc {
  margin-top: 4rpx;
  color: #9ca3af;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

/* Collaboration banner redesign: cleaner hierarchy and real friend names. */
.pf-sync-card {
  position: relative;
  min-height: 248rpx;
  margin-top: 28rpx;
  padding: 40rpx 36rpx 30rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background:
    linear-gradient(
      90deg,
      rgba(255, 244, 223, 0.98) 0%,
      rgba(255, 244, 223, 0.96) 45%,
      rgba(255, 229, 197, 0.82) 100%
    ),
    radial-gradient(circle at 82% 24%, rgba(255, 255, 255, 0.92) 0, rgba(255, 255, 255, 0) 164rpx);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.03),
    0 14rpx 38rpx rgba(255, 122, 0, 0.08);
}

.pf-sync-card::after {
  position: absolute;
  top: 0;
  right: 300rpx;
  bottom: 0;
  z-index: 2;
  width: 160rpx;
  background: linear-gradient(
    90deg,
    #fff4df 0%,
    rgba(255, 244, 223, 0.9) 54%,
    rgba(255, 244, 223, 0) 100%
  );
  content: "";
  pointer-events: none;
}

.pf-invite-bg {
  position: absolute;
  top: 0;
  right: -28rpx;
  z-index: 0;
  width: 390rpx;
  height: 100%;
  opacity: 0.96;
  pointer-events: none;
}

.pf-card-head {
  position: relative;
  z-index: 5;
  max-width: 420rpx;
}

.pf-card-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
}

.pf-sync-title {
  color: #5a270f;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
  white-space: nowrap;
}

.pf-sync-desc {
  margin-top: 16rpx;
  color: #7b5b48;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
}

.pf-card-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: flex-start;
  width: auto;
  max-width: 100%;
  gap: 14rpx;
  margin-top: 24rpx;
}

.pf-invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 5;
  width: 224rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1;
  text-align: center;
  background: linear-gradient(135deg, #ff921c 0%, #ff6200 100%);
  box-shadow: 0 14rpx 28rpx rgba(255, 101, 0, 0.2);
}

.pf-invite-btn.is-busy {
  opacity: 0.72;
  pointer-events: none;
}

.pf-share-wrap {
  position: relative;
  display: inline-flex;
  align-self: flex-start;
  flex: 0 0 auto;
}

.pf-share-face {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.16);
  pointer-events: none;
}

.pf-share-hit {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  opacity: 0;
  background: transparent;
}

.pf-share-hit::after {
  border: 0;
}

.pf-member-row {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 388rpx;
  min-height: 62rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.16),
    0 10rpx 20rpx rgba(255, 122, 0, 0.08);
}

.pf-member-tag {
  min-width: 58rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 36rpx;
  background: #fff0bf;
}

.pf-member-names {
  max-width: 274rpx;
  color: #5d3828;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1;
}

@media (max-width: 340px) {
  .pf-topline {
    width: calc(100% - 252rpx);
    max-width: 300rpx;
    margin-left: 252rpx;
    padding-top: 72rpx;
  }

  .pf-copy.is-guest {
    gap: 14rpx;
    padding-bottom: 8rpx;
  }

  .pf-login-face {
    height: 58rpx;
    padding: 0 18rpx;
  }

  .pf-login-text {
    font-size: 24rpx;
  }

  .pf-login-ico {
    width: 30rpx;
    height: 30rpx;
    font-size: 19rpx;
  }

  .pf-overview.is-guest {
    margin-top: -16rpx;
  }

  .pf-copy,
  .pf-name-row {
    width: 100%;
    max-width: 100%;
  }

  .pf-name {
    max-width: 100%;
  }

  .pf-location {
    width: 100%;
    max-width: 100%;
    gap: 7rpx;
    font-size: 19rpx;
  }

  .pf-record-pill {
    height: 46rpx;
    padding: 0 14rpx;
  }

  .pf-record-text {
    font-size: 22rpx;
  }

  .pf-record-num {
    font-size: 26rpx;
    transform: translateY(1rpx);
  }

  .pf-overview {
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 0.82fr) minmax(0, 1.36fr);
    border-radius: 30rpx;
  }

  .pf-stat {
    gap: 8rpx;
    min-height: 132rpx;
    padding: 16rpx 8rpx 16rpx 14rpx;
  }

  .pf-stat-icon {
    flex-basis: 50rpx;
    width: 50rpx;
    height: 50rpx;
  }

  .pf-stat-pic {
    width: 50rpx;
    height: 50rpx;
  }

  .pf-stat-val {
    font-size: 28rpx;
  }

  .pf-stat-val.is-compact {
    font-size: 22rpx;
  }

  .pf-stat-val.is-time {
    font-size: 21rpx;
  }

  .pf-stat-title {
    font-size: 20rpx;
  }

  .pf-stat-desc {
    font-size: 17rpx;
  }

  .pf-sync-card {
    min-height: 226rpx;
    padding: 34rpx 28rpx 24rpx;
  }

  .pf-sync-title {
    font-size: 32rpx;
  }

  .pf-sync-desc {
    font-size: 22rpx;
  }

  .pf-invite-bg {
    right: -58rpx;
    width: 318rpx;
    height: 218rpx;
  }

  .pf-sync-card::after {
    right: 220rpx;
    width: 118rpx;
  }

  .pf-invite-btn {
    width: 188rpx;
    height: 58rpx;
    min-height: 58rpx;
    font-size: 23rpx;
    line-height: 58rpx;
  }

  .pf-share-face {
    height: 58rpx;
    padding: 0 18rpx;
    font-size: 23rpx;
  }
}
