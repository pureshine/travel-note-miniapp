/* Profile tab polish — single source (page wxss keeps setup sheet only). */

/* Design refresh: profile dashboard with large duck mascot and orange invite card. */
.profile-page {
  position: relative;
}

.profile-brand {
  margin: 4rpx 0 22rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.profile-brand-hot {
  color: #ff6500;
}

.profile-hero {
  position: relative;
  min-height: 382rpx;
  padding: 40rpx 30rpx 34rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background:
    linear-gradient(
      90deg,
      rgba(249, 251, 255, 0) 0%,
      rgba(249, 251, 255, 0.88) 50%,
      rgba(249, 251, 255, 0.92) 100%
    ),
    radial-gradient(circle at 25% 15%, rgba(255, 122, 0, 0.12) 0, rgba(255, 122, 0, 0) 230rpx);
  box-shadow: none;
}

.profile-hero-duck {
  position: absolute;
  left: -42rpx;
  bottom: -10rpx;
  z-index: 0;
  width: 380rpx;
  height: 380rpx;
  pointer-events: none;
}

.hero-topline {
  position: relative;
  z-index: 1;
  margin-left: 330rpx;
  min-height: 214rpx;
}

.avatar-button,
.brand-mark {
  width: 1rpx;
  min-width: 1rpx;
  max-width: 1rpx;
  height: 1rpx;
  opacity: 0;
}

.hero-copy {
  min-width: 0;
}

.profile-name {
  overflow: hidden;
  color: #111827;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subtitle {
  color: #6b7280;
  font-size: 27rpx;
  font-weight: 750;
}

.profile-arrow {
  color: #8a93a3;
}

.login-actions {
  position: relative;
  z-index: 2;
  margin-left: 330rpx;
}

.login-button {
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22);
}

.sync-card {
  min-height: 260rpx;
  padding: 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff1db 0%, #fff8ed 54%, #ffe0c1 100%);
}

.invite-bg-duck {
  position: absolute;
  right: -8rpx;
  bottom: 0;
  z-index: 0;
  width: 360rpx;
  height: 220rpx;
  opacity: 0.96;
  pointer-events: none;
}

.sync-title {
  color: #5d2b13;
  font-size: 40rpx;
  font-weight: 950;
}

.sync-desc,
.sync-tip,
.invite-desc,
.member-names {
  color: #7d5f4b;
}

.sync-badge {
  display: none;
}

.invite-strip {
  max-width: 380rpx;
  padding: 0;
  background: transparent;
}

.invite-icon {
  display: none;
}

.invite-title {
  color: #5d2b13;
  font-size: 30rpx;
}

.soft-action.full,
.share-action {
  position: relative;
  z-index: 1;
  width: 250rpx;
  height: 78rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.2);
}

.share-action {
  background: rgba(255, 255, 255, 0.86);
  color: #ff6500;
}

.tool-grid {
  display: block;
  margin-top: 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
}

.tool-card {
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  column-gap: 18rpx;
  align-items: center;
  padding: 28rpx 26rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.tool-card + .tool-card {
  border-top: 1rpx solid rgba(226, 232, 240, 0.86);
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  grid-row: span 2;
  border-radius: 20rpx;
  background: #f1f5f9;
  color: #4b5563;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.tool-title {
  margin-top: 0;
  color: #111827;
  font-size: 30rpx;
}

.tool-desc {
  color: #7d8593;
}

@media (max-width: 340px) {
  .profile-hero-duck {
    left: -70rpx;
    width: 340rpx;
    height: 340rpx;
  }

  .hero-topline,
  .login-actions {
    margin-left: 270rpx;
  }

  .profile-name {
    font-size: 40rpx;
  }
}

