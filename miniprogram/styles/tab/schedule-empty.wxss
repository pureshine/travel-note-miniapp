/* Schedule empty & onboarding — split from schedule-timeline for file size. */

.sch-tip-empty {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  min-height: 126rpx;
  padding: 26rpx 30rpx;
  background:
    radial-gradient(circle at 12% 50%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 154rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 251, 255, 0.96) 100%);
}

.is-tip-alt {
  font-size: 32rpx;
  font-weight: 850;
}

.is-sub-alt {
  color: #8a93a3;
  font-size: 24rpx;
  white-space: normal;
}

.is-meta-hide {
  display: none;
}

.sch-board-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  margin: 18rpx 24rpx 10rpx 4rpx;
  padding: 38rpx 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 38rpx;
  color: #8a93a3;
  text-align: center;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 190rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 251, 255, 0.96) 100%);
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.035),
    0 18rpx 54rpx rgba(255, 122, 0, 0.05);
}

.sch-board-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 28rpx;
  color: #ff6500;
  font-size: 42rpx;
  font-weight: 700;
  background: #fff0e5;
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.12);
}

.sch-empty-title {
  margin-top: 22rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.2;
}

.sch-empty-desc {
  margin-top: 12rpx;
  color: #8a93a3;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}

.sch-no-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  align-items: center;
  min-height: 180rpx;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 88% 34%, rgba(255, 122, 0, 0.13) 0, rgba(255, 122, 0, 0) 138rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.86) 0%, rgba(255, 248, 239, 0.94) 100%);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.82),
    0 12rpx 30rpx rgba(255, 122, 0, 0.08);
}

.sch-no-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.sch-no-kicker {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1df;
  color: #ff6500;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 42rpx;
}

.sch-no-title {
  margin-top: 18rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.16;
}

.sch-no-desc {
  margin-top: 10rpx;
  color: #818a99;
  font-size: 24rpx;
  line-height: 1.45;
}

.sch-no-visual {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #fff8e8 0%, #ffe3bd 100%);
  box-shadow: 0 16rpx 36rpx rgba(255, 122, 0, 0.14);
  transform: rotate(-5deg);
}

.sch-no-visual::after {
  content: "";
  position: absolute;
  right: -36rpx;
  bottom: -40rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.12);
}

.sch-no-foot {
  position: relative;
  z-index: 1;
  width: 74rpx;
  height: 74rpx;
}

.sch-quick-add.sch-quick-main {
  width: 420rpx;
  max-width: 100%;
  margin: 24rpx auto 0;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  box-shadow:
    0 18rpx 34rpx rgba(255, 101, 0, 0.2),
    0 8rpx 22rpx rgba(255, 122, 0, 0.12);
}

.sch-no-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.sch-no-step {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 223, 0.84);
  color: #b58b6a;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

@media (max-width: 340px) {
  .sch-tip-empty {
    min-height: 112rpx;
    padding: 22rpx 24rpx;
  }

  .sch-empty-title {
    font-size: 30rpx;
  }

  .sch-empty-desc {
    font-size: 23rpx;
  }
}
