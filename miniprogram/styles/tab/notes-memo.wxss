/* Notes tab polish — single source (page wxss keeps layout skeleton only). */

.notes-page {
  background:
    radial-gradient(
      circle at 84% 6%,
      rgba(255, 255, 255, 0.96) 0,
      rgba(255, 255, 255, 0) 230rpx
    ),
    radial-gradient(
      circle at 72% 20%,
      rgba(255, 122, 0, 0.055) 0,
      rgba(255, 122, 0, 0) 220rpx
    ),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.notes-page .custom-nav {
  display: flex;
}

.notes-page .custom-nav-logo {
  opacity: 0;
}

/* Hero */
.notes-page .memo-hero {
  position: relative;
  box-sizing: border-box;
  height: 344rpx;
  min-height: 344rpx;
  margin: 0 -4rpx 14rpx;
  padding: 0 30rpx;
  overflow: hidden;
  border-radius: 0;
  background:
    radial-gradient(
      circle at 67% 54%,
      rgba(255, 219, 92, 0.34) 0,
      rgba(255, 219, 92, 0.18) 76rpx,
      rgba(255, 219, 92, 0) 176rpx
    ),
    linear-gradient(
      180deg,
      rgba(248, 251, 255, 0.98) 0%,
      rgba(241, 246, 253, 0.96) 100%
    );
  box-shadow: none;
}

.notes-page .memo-hero-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.notes-page .memo-hero-logo {
  display: block;
  width: 412rpx;
  height: 128rpx;
  margin-top: 16rpx;
  margin-left: -8rpx;
}

.notes-page .memo-hero-subtitle {
  margin-top: 18rpx;
  color: #7b8494;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.12;
  letter-spacing: 0;
  white-space: nowrap;
}

.notes-page .memo-progress-pill {
  display: flex;
  width: 400rpx;
  height: 70rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.03),
    0 14rpx 34rpx rgba(15, 23, 42, 0.055),
    0 8rpx 32rpx rgba(255, 122, 0, 0.05);
  backdrop-filter: blur(16rpx);
}

.notes-page .memo-progress-copy {
  display: flex;
  align-items: baseline;
  min-width: 178rpx;
  color: #667084;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.notes-page .memo-progress-label {
  margin-right: 8rpx;
}

.notes-page .memo-progress-done {
  color: #ff6500;
  font-size: 38rpx;
  font-weight: 900;
}

.notes-page .memo-progress-total {
  margin-left: 6rpx;
  color: #4b5565;
  font-size: 28rpx;
  font-weight: 650;
}

.notes-page .memo-progress-track {
  width: 110rpx;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dde4ed;
}

.notes-page .memo-progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff7a00 0%, #ff5400 100%);
  box-shadow: 0 3rpx 9rpx rgba(255, 101, 0, 0.22);
  transition: width 0.25s ease;
}

.notes-page .memo-hero-duck {
  position: absolute;
  top: 54rpx;
  right: -8rpx;
  z-index: 1;
  width: 326rpx;
  height: 304rpx;
}

/* CTA row */
.legacy-title-row {
  margin-bottom: 20rpx;
}

.legacy-title-row > view:first-child {
  display: none;
}

.legacy-title-row .memo-actions {
  width: 100%;
}

.notes-page .legacy-title-row {
  margin: 0 0 18rpx;
}

.notes-page .legacy-title-row .memo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  padding: 0;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.2);
}

.notes-page .memo-add-text {
  display: inline-flex;
  align-items: center;
  line-height: 1;
}

.notes-page .memo-add-text::before {
  display: inline-flex;
  align-items: center;
  margin-right: 10rpx;
  line-height: 1;
  content: "+";
  font-size: 30rpx;
  font-weight: 900;
}

.notes-page .memo-duck,
.notes-page .memo-foot {
  display: none;
}

/* Filter tabs */
.filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 118rpx;
  height: 66rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  color: #313844;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.filter-chip.active {
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(255, 101, 0, 0.2);
}

.filter-chip::after {
  border: 0;
}

.notes-page .filter-scroll {
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 42rpx;
}

.notes-page .filter-row {
  width: 100%;
  box-sizing: border-box;
  justify-content: space-between;
  gap: 8rpx;
}

.notes-page .filter-chip {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 12rpx;
  font-size: 26rpx;
  line-height: 1;
}

/* Note list */
.note-list {
  gap: 16rpx;
}

.note-card {
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
}

.note-swipe {
  min-height: 112rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
}

.note-top {
  gap: 24rpx;
}

.check-dot {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #ff6500;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
}

.note-title {
  overflow: hidden;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-content {
  color: #7d8593;
}

.note-tag {
  flex: 0 0 auto;
  max-width: 140rpx;
  overflow: hidden;
  background: #fff0e5;
  color: #ff6500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notes-page .note-card {
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffffff;
}

.notes-page .note-actions {
  z-index: 1;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
}

.notes-page .note-card.open .note-actions {
  opacity: 1;
  pointer-events: auto;
}

.notes-page .note-swipe {
  z-index: 2;
  width: 100%;
  box-sizing: border-box;
  background:
    radial-gradient(
      circle at 0% 50%,
      rgba(255, 122, 0, 0.08) 0,
      rgba(255, 122, 0, 0) 130rpx
    ),
    #ffffff;
}

.notes-page .note-swipe.open {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  transform: translateX(-220rpx);
}

.notes-page .note-card.open .note-actions {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.notes-page .note-action.edit {
  background: #ff9a1f;
}

.notes-page .note-action.danger {
  background: #ef5b48;
}

/* Completed items */
.notes-page .note-card.done,
.notes-page .note-card.done.panel {
  opacity: 1;
  border: 0;
  background: #fff0e3;
  box-shadow: none;
}

.notes-page .note-card.done .note-swipe {
  background: #fff0e3;
  border: 0;
  box-shadow: none;
}

.notes-page .note-card.done .check-dot {
  border-color: #ff6500;
  background: linear-gradient(135deg, #ff8a18 0%, #ff5f00 100%);
  color: #ffffff;
  box-shadow: none;
}

.notes-page .note-card.done .note-title {
  color: #89958f;
  text-decoration: line-through;
  text-decoration-color: rgba(255, 101, 0, 0.5);
  text-decoration-thickness: 3rpx;
}

.notes-page .note-card.done .note-content {
  color: #9aa5a0;
}

.notes-page .note-card.done .note-tag {
  background: rgba(255, 122, 0, 0.1);
  color: #ff6500;
}

@media (max-width: 340px) {
  .notes-page .memo-hero {
    height: 306rpx;
    min-height: 306rpx;
  }

  .notes-page .memo-hero-copy {
    width: 362rpx;
  }

  .notes-page .memo-hero-logo {
    width: 340rpx;
    height: 106rpx;
    margin-top: 14rpx;
  }

  .notes-page .memo-hero-subtitle {
    margin-top: 14rpx;
    font-size: 25rpx;
  }

  .notes-page .memo-progress-pill {
    width: 340rpx;
    height: 64rpx;
    margin-top: 18rpx;
  }

  .notes-page .memo-progress-track {
    width: 82rpx;
  }

  .notes-page .memo-hero-duck {
    top: 56rpx;
    right: -24rpx;
    width: 270rpx;
    height: 252rpx;
  }

  .notes-page .filter-chip {
    font-size: 23rpx;
  }
}
