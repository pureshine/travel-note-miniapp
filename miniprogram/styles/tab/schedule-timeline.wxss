/* Schedule tab polish — single source (page wxss keeps layout skeleton). */

.sch-page {
  position: relative;
  background:
    radial-gradient(circle at 84% 6%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 230rpx),
    radial-gradient(circle at 72% 20%, rgba(255, 122, 0, 0.055) 0, rgba(255, 122, 0, 0) 220rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

/* Premium plan summary card. */
.sch-tip {
  position: relative;
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr) 134rpx;
  align-items: center;
  gap: 18rpx;
  min-height: 168rpx;
  padding: 28rpx 30rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 12% 50%, rgba(255, 122, 0, 0.14) 0, rgba(255, 122, 0, 0) 150rpx),
    radial-gradient(circle at 92% 0%, rgba(255, 215, 122, 0.14) 0, rgba(255, 215, 122, 0) 170rpx),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(249, 252, 255, 0.95) 58%,
      rgba(255, 246, 237, 0.92) 100%
    );
  box-shadow:
    0 8rpx 28rpx rgba(15, 23, 42, 0.045),
    0 20rpx 58rpx rgba(255, 122, 0, 0.08);
  backdrop-filter: blur(18rpx);
}

.sch-tip-icon {
  position: relative;
  z-index: 1;
  width: 108rpx;
  height: 108rpx;
  overflow: visible;
  border-radius: 32rpx;
}

.sch-tip-duck {
  width: 126rpx;
  height: 126rpx;
  transform: translate(-8rpx, -10rpx);
}

.sch-tip-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.sch-tip-title {
  max-width: 100%;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.24;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-tip-sub {
  max-width: 100%;
  margin-top: 8rpx;
  overflow: visible;
  color: #7d8593;
  font-size: 23rpx;
  line-height: 1.25;
  text-overflow: clip;
  white-space: nowrap;
}

.sch-tip-meta {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  gap: 12rpx;
  align-items: flex-end;
  color: #7d8593;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
}

.sch-tip-meta text {
  max-width: 132rpx;
  padding: 9rpx 15rpx;
  overflow: hidden;
  border-radius: 999rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-tip-meta text:first-child {
  color: #111827;
  background: rgba(248, 250, 252, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(226, 232, 240, 0.86);
}

.sch-tip-meta text:last-child {
  color: #ff6500;
  background: rgba(255, 240, 229, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.1);
}

/* Premium current-plan controls. */
.sch-plan {
  position: relative;
  padding: 26rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 16% 10%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 180rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(249, 252, 255, 0.94) 100%);
  box-shadow:
    0 10rpx 30rpx rgba(15, 23, 42, 0.04),
    0 20rpx 60rpx rgba(255, 122, 0, 0.055);
}

.sch-plan-main {
  width: 100%;
}

.sch-plan-ops {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.sch-plan-pick,
.sch-plan-pill {
  min-height: 88rpx;
}

.sch-plan-pick {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 100%;
}

.sch-plan-pill {
  position: relative;
  display: flex;
  gap: 14rpx;
  align-items: center;
  min-width: 0;
  padding: 0 16rpx 0 20rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 0% 50%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 116rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 250, 253, 0.94) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    inset 0 0 0 1rpx rgba(241, 245, 249, 0.88),
    0 8rpx 22rpx rgba(15, 23, 42, 0.032);
}

.sch-plan-dot {
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow:
    0 0 0 10rpx rgba(255, 122, 0, 0.14),
    0 8rpx 16rpx rgba(255, 122, 0, 0.16);
}

.sch-plan-dot.done {
  background: #9ca3af;
  box-shadow: 0 0 0 10rpx rgba(156, 163, 175, 0.15);
}

.sch-plan-copy {
  flex: 1;
  min-width: 0;
}

.sch-plan-label {
  color: #8a93a3;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.15;
}

.sch-plan-name {
  margin-top: 4rpx;
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-status {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.sch-plan-tail {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 14rpx 9rpx 18rpx;
  border-radius: 999rpx;
}

.sch-plan-tail.upcoming {
  background: linear-gradient(135deg, rgba(255, 245, 223, 0.98) 0%, rgba(255, 237, 204, 0.96) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88),
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.14);
}

.sch-plan-tail.upcoming .sch-status {
  color: #ff6500;
}

.sch-plan-tail.done {
  background: rgba(243, 244, 246, 0.96);
  box-shadow: inset 0 0 0 1rpx rgba(209, 213, 219, 0.76);
}

.sch-plan-tail.done .sch-status {
  color: #6b7280;
}

.sch-plan-tail .sch-plan-more {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6500;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  background: transparent;
  box-shadow: none;
}

.sch-plan-tail.done .sch-plan-more {
  color: #6b7280;
}

.sch-plan-menu {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 3;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #ff6500;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -1rpx;
  white-space: nowrap;
  background: linear-gradient(135deg, rgba(255, 245, 223, 0.98) 0%, rgba(255, 237, 204, 0.96) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88),
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.14);
}

.sch-plan-menu::after,
.sch-quick-add::after {
  border: 0;
}

.sch-quick-add {
  width: 368rpx;
  max-width: calc(100% - 80rpx);
  height: 86rpx;
  margin: 22rpx auto 0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 86rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 221, 128, 0.5) 0, rgba(255, 221, 128, 0) 80rpx),
    linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  box-shadow:
    0 14rpx 28rpx rgba(255, 101, 0, 0.22),
    0 26rpx 50rpx rgba(255, 122, 0, 0.12);
}

/* Itinerary timeline: image-card layout matching the supplied design. */
.sch-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 52rpx;
  margin: 32rpx 0 18rpx;
}

.sch-head text {
  color: #111827;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.2;
}

.sch-head .sch-head-count {
  min-width: 58rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #8a6a52;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 42rpx;
  text-align: center;
  background: rgba(255, 248, 241, 0.86);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.13),
    0 6rpx 16rpx rgba(255, 122, 0, 0.045);
}

.sch-filter-anchor {
  margin-bottom: 18rpx;
}

.sch-filter-anchor.is-docked {
  height: 80rpx;
}

.sch-filter {
  position: relative;
  z-index: 8;
  padding: 0 8rpx;
  overflow: visible;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.04);
}

.sch-filter.is-fixed {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 990;
}

.sch-filter-grid {
  display: flex;
  align-items: stretch;
}

.sch-filter-cell {
  position: relative;
  flex: 1;
  min-width: 0;
}

.sch-filter-cell:not(:last-child)::after {
  position: absolute;
  top: 22rpx;
  right: 0;
  width: 1rpx;
  height: 32rpx;
  background: rgba(229, 231, 235, 0.9);
  content: "";
  pointer-events: none;
}

.sch-filter-pick {
  min-width: 0;
}

.sch-filter-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 12rpx 0 14rpx;
}

.sch-filter-chip.has-clear {
  padding-right: 34rpx;
}

.sch-filter-label {
  flex-shrink: 0;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.sch-filter-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f2937;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-filter-chip.has-clear .sch-filter-value {
  color: #ff6500;
  font-weight: 800;
}

.sch-filter-caret {
  flex-shrink: 0;
  margin-left: 2rpx;
  color: #d1d5db;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.sch-filter-list {
  position: absolute;
  top: calc(100% + 6rpx);
  left: 10rpx;
  right: 10rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  max-height: 300rpx;
  padding: 8rpx;
  overflow: auto;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.12);
}

.sch-filter-item {
  min-height: 54rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.sch-filter-item.is-on {
  color: #ff6500;
  background: rgba(255, 101, 0, 0.1);
}

.sch-filter-clear {
  position: absolute;
  top: 50%;
  right: 10rpx;
  z-index: 22;
  color: #ff6500;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  transform: translateY(-50%);
}

.sch-filter-clear:active {
  opacity: 0.55;
}

.sch-board {
  position: relative;
  padding: 0 0 20rpx;
  overflow: visible;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.sch-year {
  position: relative;
}

.sch-year-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 54rpx;
  margin: 4rpx 0 10rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 28rpx;
  font-weight: 950;
  background: rgba(255, 240, 229, 0.96);
}

.sch-row {
  display: grid;
  grid-template-columns: 142rpx 42rpx minmax(0, 1fr);
  gap: 12rpx;
  align-items: start;
  padding: 20rpx 0 30rpx;
}

.sch-time {
  align-items: flex-end;
  padding-left: 8rpx;
  padding-top: 8rpx;
}

.sch-day {
  color: #8a93a3;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.05;
}

.sch-hour {
  margin-top: 8rpx;
  color: #ff6500;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.05;
  white-space: nowrap;
}

.sch-hour.is-range {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.sch-row.is-active .sch-hour {
  color: #b24a57;
}

.sch-row.is-pending .sch-hour {
  color: #ff6500;
}

.sch-row.is-done .sch-hour {
  color: #2f8f68;
}

.sch-state {
  margin-top: 18rpx;
  padding: 8rpx 13rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.15;
}

.sch-state.done {
  color: #2f8f68;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.68) 0, rgba(255, 255, 255, 0) 42rpx),
    linear-gradient(135deg, #e8f8ef 0%, #d5f1e2 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(47, 143, 104, 0.12),
    0 6rpx 14rpx rgba(47, 143, 104, 0.06);
}

.sch-state.active {
  color: #9f3445;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.72) 0, rgba(255, 255, 255, 0) 42rpx),
    linear-gradient(135deg, #fff2f3 0%, #ffdfe4 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(178, 74, 87, 0.14),
    0 7rpx 16rpx rgba(178, 74, 87, 0.08);
}

.sch-state.pending {
  color: #b96319;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.68) 0, rgba(255, 255, 255, 0) 42rpx),
    linear-gradient(135deg, #fff6ea 0%, #ffe8cc 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(185, 99, 25, 0.11),
    0 6rpx 14rpx rgba(185, 99, 25, 0.05);
}

.sch-line {
  min-height: 204rpx;
}

.sch-line::after {
  top: 28rpx;
  bottom: -50rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #ff6500 0%, rgba(255, 101, 0, 0.12) 100%);
}

.sch-row.is-active .sch-line::after {
  background: linear-gradient(180deg, rgba(178, 74, 87, 0.68) 0%, rgba(178, 74, 87, 0.08) 100%);
}

.sch-row.is-pending .sch-line::after {
  background: linear-gradient(180deg, rgba(255, 101, 0, 0.72) 0%, rgba(255, 101, 0, 0.1) 100%);
}

.sch-row.is-done .sch-line::after {
  background: linear-gradient(180deg, rgba(47, 143, 104, 0.62) 0%, rgba(47, 143, 104, 0.08) 100%);
}

.sch-row:last-child .sch-line::after {
  display: none;
}

.sch-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 9rpx;
  border: 8rpx solid #ffffff;
  background: #ff6500;
  box-shadow:
    0 0 0 2rpx rgba(255, 101, 0, 0.1),
    0 8rpx 20rpx rgba(255, 101, 0, 0.18);
}

.sch-row.is-active .sch-dot {
  background: #b24a57;
  box-shadow:
    0 0 0 2rpx rgba(178, 74, 87, 0.1),
    0 8rpx 20rpx rgba(178, 74, 87, 0.14);
}

.sch-row.is-pending .sch-dot {
  background: #ff6500;
}

.sch-row.is-done .sch-dot {
  background: #2f8f68;
  box-shadow:
    0 0 0 2rpx rgba(47, 143, 104, 0.1),
    0 8rpx 20rpx rgba(47, 143, 104, 0.13);
}

.sch-wrap {
  isolation: isolate;
  border-radius: 34rpx;
}

.sch-wrap.is-wrap-open {
  z-index: 2;
  overflow: hidden;
}

.sch-card {
  position: relative;
  z-index: 2;
  display: block;
  min-height: 164rpx;
  padding: 32rpx 34rpx;
  overflow: visible;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 0% 20%, rgba(255, 122, 0, 0.09) 0, rgba(255, 122, 0, 0) 142rpx),
    linear-gradient(100deg, #ffffff 0%, #ffffff 56%, #fff7f0 100%);
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.045),
    0 18rpx 52rpx rgba(255, 122, 0, 0.055);
  transition: transform 0.18s ease;
}

.sch-card.is-active {
  background:
    radial-gradient(circle at 0% 20%, rgba(178, 74, 87, 0.06) 0, rgba(178, 74, 87, 0) 142rpx),
    linear-gradient(100deg, #ffffff 0%, #ffffff 56%, #fff7f8 100%);
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.042),
    0 18rpx 52rpx rgba(178, 74, 87, 0.04);
}

.sch-card.is-pending {
  background:
    radial-gradient(circle at 0% 20%, rgba(255, 122, 0, 0.075) 0, rgba(255, 122, 0, 0) 142rpx),
    linear-gradient(100deg, #ffffff 0%, #ffffff 56%, #fff8f1 100%);
}

.sch-card.is-done {
  background:
    radial-gradient(circle at 0% 20%, rgba(47, 143, 104, 0.065) 0, rgba(47, 143, 104, 0) 142rpx),
    linear-gradient(100deg, #ffffff 0%, #ffffff 56%, #f4fbf7 100%);
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.038),
    0 18rpx 52rpx rgba(47, 143, 104, 0.038);
}

.sch-card.is-active {
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 18rpx 48rpx rgba(178, 74, 87, 0.075);
}

.sch-card.is-pic {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  gap: 22rpx;
  align-items: center;
  min-height: 194rpx;
  padding: 28rpx;
}

.sch-card::before {
  position: absolute;
  top: 72rpx;
  left: -13rpx;
  width: 28rpx;
  height: 28rpx;
  content: "";
  background: rgba(255, 255, 255, 0.96);
  border-radius: 6rpx;
  transform: rotate(45deg);
}

.sch-card-copy {
  min-width: 0;
}

.sch-card-head {
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sch-tag {
  padding: 8rpx 16rpx;
  color: #ff6500;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.1;
  background: rgba(255, 240, 229, 0.98);
  border-radius: 999rpx;
}

.sch-place {
  color: #7d8593;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
}

.sch-card-title {
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-card.is-active .sch-card-title {
  color: #7c2d3a;
}

.sch-card.is-pending .sch-card-title {
  color: #111827;
}

.sch-card.is-done .sch-card-title {
  color: #185b43;
}

.sch-card-note {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #7d8593;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.sch-card.is-active .sch-card-note {
  color: #9b5c64;
}

.sch-card.is-done .sch-card-note {
  color: #5f8d77;
}

.sch-card-swiper {
  width: 176rpx;
  height: 142rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #eef2f7;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.08);
}

.sch-card-pic {
  display: block;
  width: 176rpx;
  height: 142rpx;
  margin: 0;
  border-radius: 24rpx;
  background: #eef2f7;
}

/* Swipe actions and event surface. */
.sch-card.is-slide {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right: 0;
  transform: translateX(-208rpx);
  background: #ffffff;
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.045),
    0 18rpx 52rpx rgba(255, 122, 0, 0.055);
}

.sch-card.is-slide::before {
  display: none;
}

.sch-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 104rpx);
  width: 208rpx;
  overflow: hidden;
  border-radius: 0 34rpx 34rpx 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
}

.sch-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.sch-action.is-edit {
  background: #ff9a1f;
}

.sch-action.is-danger {
  background: #ef5b48;
}

.sch-actions.is-show {
  opacity: 1;
  pointer-events: auto;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

@media (max-width: 340px) {
  .sch-tip {
    grid-template-columns: 86rpx minmax(0, 1fr) 118rpx;
    gap: 12rpx;
    min-height: 148rpx;
    padding: 22rpx 22rpx;
    border-radius: 34rpx;
  }

  .sch-tip-icon {
    width: 90rpx;
    height: 90rpx;
    border-radius: 27rpx;
  }

  .sch-tip-duck {
    width: 108rpx;
    height: 108rpx;
    transform: translate(-7rpx, -9rpx);
  }

  .sch-tip-title {
    font-size: 30rpx;
    font-weight: 700;
  }

  .sch-tip-sub,
  .sch-tip-meta {
    font-size: 22rpx;
  }

  .sch-tip-sub {
    white-space: normal;
  }

  .sch-tip-meta text {
    max-width: 112rpx;
    padding: 7rpx 11rpx;
  }

  .sch-plan {
    padding: 22rpx;
    border-radius: 36rpx;
  }

  .sch-plan-main {
    width: 100%;
  }

  .sch-plan-ops {
    gap: 6rpx;
  }

  .sch-plan-pick,
  .sch-plan-pill {
    min-height: 78rpx;
  }

  .sch-plan-pill {
    padding: 0 12rpx 0 18rpx;
    border-radius: 27rpx;
  }

  .sch-plan-tail {
    gap: 6rpx;
    padding: 8rpx 12rpx 8rpx 14rpx;
  }

  .sch-status {
    font-size: 21rpx;
  }

  .sch-plan-tail .sch-plan-more {
    font-size: 24rpx;
  }

  .sch-plan-menu {
    width: 36rpx;
    height: 36rpx;
    font-size: 20rpx;
  }

  .sch-quick-add {
    width: 336rpx;
    max-width: calc(100% - 48rpx);
    height: 78rpx;
    font-size: 27rpx;
    line-height: 78rpx;
    border-radius: 30rpx;
  }

  .sch-head text {
    font-size: 34rpx;
  }

  .sch-head .sch-head-count {
    min-width: 52rpx;
    height: 38rpx;
    padding: 0 12rpx;
    font-size: 19rpx;
    line-height: 38rpx;
  }

  .sch-filter {
    padding: 0 6rpx;
    border-radius: 20rpx;
  }

  .sch-filter-anchor.is-docked {
    height: 156rpx;
  }

  .sch-filter-grid {
    flex-direction: column;
  }

  .sch-filter-cell:not(:last-child)::after {
    top: auto;
    right: 14rpx;
    bottom: 0;
    left: 14rpx;
    width: auto;
    height: 1rpx;
  }

  .sch-filter-chip {
    min-height: 64rpx;
    padding: 0 12rpx;
  }

  .sch-filter-chip.has-clear {
    padding-right: 32rpx;
  }

  .sch-filter-label,
  .sch-filter-value {
    font-size: 21rpx;
  }

  .sch-filter-caret {
    font-size: 18rpx;
  }

  .sch-row {
    grid-template-columns: 122rpx 34rpx minmax(0, 1fr);
    gap: 8rpx;
    padding-bottom: 26rpx;
  }

  .sch-hour {
    font-size: 31rpx;
  }

  .sch-hour.is-range {
    font-size: 20rpx;
  }

  .sch-day,
  .sch-card-note,
  .sch-place {
    font-size: 22rpx;
  }

  .sch-state,
  .sch-tag {
    font-size: 20rpx;
  }

  .sch-card.is-pic {
    grid-template-columns: minmax(0, 1fr) 136rpx;
    gap: 16rpx;
    min-height: 168rpx;
    padding: 24rpx;
  }

  .sch-card-title {
    font-size: 30rpx;
  }

  .sch-card-swiper,
  .sch-card-pic {
    width: 136rpx;
    height: 124rpx;
    border-radius: 22rpx;
  }

  .sch-card.is-slide {
    transform: translateX(-184rpx);
  }

  .sch-actions {
    grid-template-columns: repeat(2, 92rpx);
    width: 184rpx;
  }

  .sch-action {
    font-size: 22rpx;
  }
}
