page {
  min-height: 100vh;
  background: #f7fafe;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  width: auto;
  min-width: 0;
  max-width: 100%;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1.2;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
  padding: 32rpx;
  background:
    radial-gradient(
      circle at 76% 8%,
      rgba(255, 255, 255, 0.95) 0,
      rgba(255, 255, 255, 0) 210rpx
    ),
    radial-gradient(
      circle at 78% 18%,
      rgba(255, 122, 0, 0.055) 0,
      rgba(255, 122, 0, 0) 220rpx
    ),
    linear-gradient(180deg, #fbfdff 0%, #f4f8fd 48%, #eef4fb 100%);
}

.schedule-page,
.notes-page,
.stats-page,
.profile-page,
.home-page {
  padding-top: calc(132rpx + env(safe-area-inset-top));
}

.schedule-page .brand-row,
.stats-page .brand-row,
.profile-page .profile-brand,
.notes-page .memo-brand,
.home-page .hero-title {
  display: none !important;
}

.custom-nav {
  position: fixed;
  left: 38rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  width: 340rpx;
  height: 84rpx;
  min-width: 0;
  overflow: visible;
  pointer-events: none;
}

.custom-nav-logo {
  display: block;
  width: 340rpx;
  height: 84rpx;
  max-width: none;
  max-height: none;
  background-image: url("data:image/png;base64,");
  background-repeat: no-repeat;
  background-position: left center;
  background-size: contain;
  transform: translateY(-10rpx);
}

.muted {
  color: #7d8593;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 18rpx;
  color: #2f2f2a;
  font-size: 32rpx;
  font-weight: 700;
}

.panel {
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
  backdrop-filter: blur(18rpx);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  font-weight: 700;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border: 2rpx solid rgba(255, 122, 0, 0.18);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #ff6500;
  font-weight: 700;
}

.field {
  min-height: 84rpx;
  width: 100%;
  padding: 0 24rpx;
  border: 2rpx solid rgba(226, 232, 240, 0.88);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #111827;
}

.textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.55;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #8a93a3;
}

.brand-wordmark {
  color: #111827;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1;
  letter-spacing: 0;
}

.brand-wordmark .brand-hot {
  color: #ff6500;
}

.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
