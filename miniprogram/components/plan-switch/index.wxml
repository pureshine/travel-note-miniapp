<view wx:if="{{tripOptions.length > 0}}" class="c-plan panel">
  <view class="c-plan-pill" bindtap="onToggleOptions">
    <view class="c-plan-dot {{statusClass}}"></view>
    <view class="c-plan-copy">
      <view class="c-plan-label">当前计划</view>
      <view class="c-plan-name">{{tripName}}</view>
    </view>
    <view class="c-plan-ops">
      <view class="c-plan-tail {{statusClass}}">
        <view wx:if="{{statusText}}" class="c-plan-status">{{statusText}}</view>
        <view class="c-plan-change">{{showOptions ? "▴" : "▾"}}</view>
      </view>
      <view wx:if="{{showMenu}}" class="c-plan-menu" catchtap="onMenuTap">⋮</view>
    </view>
  </view>
  <view wx:if="{{showOptions}}" class="c-plan-list">
    <view
      wx:for="{{tripOptions}}"
      wx:key="*this"
      class="c-plan-item {{activeIndex === index ? 'is-on' : ''}}"
      data-index="{{index}}"
      bindtap="onSelectOption"
    >
      <text class="c-plan-text">{{item}}</text>
    </view>
  </view>
</view>
