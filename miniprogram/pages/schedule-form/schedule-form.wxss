@import "../../styles/form-base.wxss";

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.time-range-panel {
  padding: 22rpx;
  border: 2rpx solid rgba(255, 122, 0, 0.1);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 142rpx),
    linear-gradient(180deg, #fffdf9 0%, #fff7ef 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.time-range-label {
  margin-bottom: 16rpx;
  color: #8a6a52;
  font-size: 23rpx;
  font-weight: 850;
}

.time-range-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44rpx minmax(0, 1fr);
  gap: 12rpx;
  align-items: center;
}

.time-chip {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 122, 0, 0.1),
    0 8rpx 20rpx rgba(255, 122, 0, 0.055);
}

.time-chip-kicker {
  color: #9a7255;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.1;
}

.time-chip-value {
  margin-top: 8rpx;
  color: #ff6500;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.1;
}

.time-range-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff9a1f;
  font-size: 28rpx;
  font-weight: 950;
}

.image-row {
  width: 100%;
  white-space: nowrap;
}

.preview-image {
  display: inline-block;
  width: 180rpx;
  height: 120rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  background: #f4eee6;
  vertical-align: top;
}

.upload-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 120rpx;
  border: 2rpx dashed #e9c7a5;
  border-radius: 24rpx;
  background: #fffaf3;
  color: #e66d35;
  font-size: 22rpx;
  font-weight: 800;
  vertical-align: top;
}

.upload-card.wide {
  width: 100%;
}

.upload-plus {
  margin-bottom: 6rpx;
  font-size: 42rpx;
  line-height: 1;
}
