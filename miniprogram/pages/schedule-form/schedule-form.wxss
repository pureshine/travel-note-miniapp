@import "../../styles/form-base.wxss";

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.image-row {
  width: 100%;
  white-space: nowrap;
}

.preview-image {
  display: inline-block;
  width: 180rpx;
  height: 120rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  background: #f4eee6;
  vertical-align: top;
}

.upload-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 120rpx;
  border: 2rpx dashed #e9c7a5;
  border-radius: 24rpx;
  background: #fffaf3;
  color: #e66d35;
  font-size: 22rpx;
  font-weight: 800;
  vertical-align: top;
}

.upload-card.wide {
  width: 100%;
}

.upload-plus {
  margin-bottom: 6rpx;
  font-size: 42rpx;
  line-height: 1;
}
