<view class="page notes-page" style="{{safeTopStyle}}">
  <brand-nav customNavStyle="{{customNavStyle}}" />
  <view class="memo-hero">
    <view class="memo-hero-copy">
      <image class="memo-hero-logo" src="/assets/design3d/memo-wordmark-transparent.png" mode="aspectFit" />
      <view class="memo-hero-subtitle">旅行清单 · 轻松出发</view>
      <view class="memo-progress-pill">
        <view class="memo-progress-copy">
          <text class="memo-progress-label">已完成</text>
          <text class="memo-progress-done">{{noteDoneCount}}</text>
          <text class="memo-progress-total">/{{noteCount}}</text>
        </view>
        <view class="memo-progress-track">
          <view class="memo-progress-fill" style="{{noteProgressStyle}}"></view>
        </view>
      </view>
    </view>
    <image
      class="memo-hero-duck"
      src="/assets/design3d/memo-duck-pencil-transparent.png"
      mode="aspectFit"
    />
  </view>

  <view wx:if="{{trip}}" class="memo-current-plan">
    <view class="memo-current-dot"></view>
    <view class="memo-current-copy">
      <view class="memo-current-label">当前计划</view>
      <view class="memo-current-name">{{trip.name}}</view>
    </view>
  </view>

  <view class="memo-title-row">
    <view class="memo-actions">
      <button class="memo-add" bindtap="goNoteForm">
        <image
          class="memo-duck"
          src="/assets/illustrations/duck-travel-sticker.png"
          mode="aspectFit"
        />
        <text class="memo-add-text"><text class="memo-plus">+</text>写备忘</text>
        <image class="memo-foot" src="/assets/illustrations/duck-foot-icon.png" mode="aspectFit" />
      </button>
    </view>
  </view>

  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-row">
      <button
        wx:for="{{filters}}"
        wx:key="*this"
        class="filter-chip {{selectedFilter === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="selectFilter"
      >{{item}}</button>
    </view>
  </scroll-view>

  <view class="note-list">
    <view
      wx:for="{{filteredNotes}}"
      wx:key="id"
      class="note-card panel {{item.done ? 'is-done' : ''}} {{openNoteId === item.id ? 'is-open' : ''}}"
    >
      <view class="note-actions">
        <button class="note-action edit" catchtap="editNoteItem" data-id="{{item.id}}">编辑</button>
        <button class="note-action danger" catchtap="deleteNoteItem" data-id="{{item.id}}">删除</button>
      </view>
      <view
        class="note-swipe {{openNoteId === item.id ? 'is-open' : ''}}"
        bindtouchstart="onNoteTouchStart"
        bindtouchmove="onNoteTouchMove"
        data-id="{{item.id}}"
      >
        <view class="note-top" bindtap="toggleItem" data-id="{{item.id}}">
          <view class="check-dot">{{item.done ? "✓" : ""}}</view>
          <view class="note-main">
            <view class="note-title">{{item.title}}</view>
            <view wx:if="{{item.content}}" class="note-content">{{item.content}}</view>
          </view>
          <view class="note-tag">{{item.category}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{filteredNotes.length === 0}}" class="empty panel">
      <image
        class="empty-duck-foot"
        src="/assets/illustrations/duck-foot-icon.png"
        mode="aspectFit"
      />
      <view>还没有备忘</view>
    </view>
  </view>
</view>
