@import "../../styles/tab/notes-memo.wxss";

/* Page skeleton only — visual polish lives in notes-memo.wxss */

.memo-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  color: #2f2f2a;
  font-size: 48rpx;
  font-weight: 850;
}

.memo-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.note-list {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.note-card {
  position: relative;
  overflow: hidden;
  padding: 0;
}

.note-swipe {
  transition: transform 0.18s ease;
}

.note-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(2, 110rpx);
  width: 220rpx;
  overflow: hidden;
  border-radius: 0 28rpx 28rpx 0;
}

.note-action {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
}

.note-top {
  display: flex;
  align-items: center;
}

.note-main {
  flex: 1;
  min-width: 0;
}

.note-content {
  margin-top: 8rpx;
  line-height: 1.6;
}

.empty-duck-foot {
  display: block;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 12rpx;
}
