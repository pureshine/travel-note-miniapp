.memo-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  color: #2f2f2a;
  font-size: 48rpx;
  font-weight: 850;
}

.memo-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.memo-duck {
  width: 46rpx;
  height: 46rpx;
}

.memo-add {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 210rpx;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff5d6 0%, #fff1df 100%);
  color: #d97949;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: inset 0 -6rpx 0 rgba(255, 138, 76, 0.08);
}

.memo-add::after {
  border: 0;
}

.memo-add-text,
.memo-add-plus {
  line-height: 1;
  white-space: nowrap;
}

.memo-add-plus {
  font-size: 30rpx;
}

.memo-foot {
  width: 34rpx;
  height: 34rpx;
}

.empty-duck-foot {
  display: block;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 12rpx;
}

.plan-switch {
  padding: 18rpx;
  margin-bottom: 22rpx;
}

.plan-picker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: #fff8ef;
}

.plan-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff8a4c;
  box-shadow: 0 0 0 8rpx rgba(255, 138, 76, 0.14);
}

.plan-copy {
  flex: 1;
  min-width: 0;
}

.plan-label {
  color: #b5a696;
  font-size: 20rpx;
  font-weight: 800;
}

.plan-name {
  margin-top: 6rpx;
  overflow: hidden;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-change {
  color: #ff8a4c;
  font-size: 23rpx;
  font-weight: 850;
  white-space: nowrap;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 30rpx;
  background: #fff4e8;
  box-shadow: inset 0 0 0 1rpx rgba(240, 223, 202, 0.58);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 98rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #a79a8b;
  font-size: 24rpx;
  font-weight: 800;
}

.filter-chip.active {
  background: #ff9d6a;
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(255, 138, 76, 0.16);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 22rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #f0dfca;
  border-radius: 26rpx;
  background: #fffaf3;
  color: #e66d35;
  font-weight: 800;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.note-card {
  position: relative;
  overflow: hidden;
  padding: 0;
}

.note-swipe {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  transition: transform 0.18s ease;
}

.note-swipe.open {
  transform: translateX(-220rpx);
}

.note-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: grid;
  grid-template-columns: repeat(2, 110rpx);
  width: 220rpx;
  overflow: hidden;
  border-radius: 0 28rpx 28rpx 0;
}

.note-action {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
}

.note-action.edit {
  background: #ffad6d;
}

.note-action.danger {
  background: #ef6b5b;
}

.note-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #eadbc8;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.note-title {
  color: #2f2f2a;
  font-size: 32rpx;
  font-weight: 800;
}

.note-main {
  flex: 1;
  min-width: 0;
}

.note-content {
  margin-top: 8rpx;
  color: #a79a8b;
  font-size: 26rpx;
  line-height: 1.6;
}

.note-tag {
  padding: 9rpx 16rpx;
  border-radius: 16rpx;
  background: #fff1df;
  color: #e66d35;
  font-size: 23rpx;
  font-weight: 800;
}

.note-card.done {
  opacity: 0.58;
}

.note-card.done .check-dot {
  border-color: #ff8a4c;
  background: #ff8a4c;
}

.note-card.done .note-title,
.note-card.done .note-content {
  color: #8a9691;
}

/* Design refresh: packing-list glass cards and orange segmented controls. */
.memo-hero {
  position: relative;
  min-height: 260rpx;
  margin: -4rpx 0 22rpx;
  padding: 30rpx 30rpx 28rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 78% 38%, rgba(255, 122, 0, 0.16) 0, rgba(255, 122, 0, 0) 150rpx),
    rgba(255, 255, 255, 0.72);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
}

.memo-hero .memo-title-row {
  align-items: flex-start;
  margin: 0;
}

.memo-brand {
  color: #111827;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.memo-brand-hot {
  color: #ff6500;
}

.memo-hero .title {
  margin-top: 34rpx;
  color: #111827;
  font-size: 58rpx;
  font-weight: 950;
  line-height: 1.06;
}

.memo-hero .muted {
  margin-top: 14rpx;
  color: #7d8593;
  font-size: 28rpx;
  font-weight: 750;
}

.memo-hero-duck {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 238rpx;
  height: 238rpx;
}

.legacy-title-row {
  margin-bottom: 20rpx;
}

.legacy-title-row > view:first-child {
  display: none;
}

.legacy-title-row .memo-actions {
  width: 100%;
}

.legacy-title-row .memo-add {
  width: 100%;
  height: 86rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.2);
}

.plan-switch {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
}

.plan-picker {
  min-height: 84rpx;
  border-radius: 28rpx;
  background: #f8fafc;
}

.plan-dot {
  background: #ff6500;
  box-shadow: 0 0 0 8rpx rgba(255, 101, 0, 0.13);
}

.plan-label,
.note-content {
  color: #7d8593;
}

.plan-name,
.note-title {
  color: #111827;
}

.plan-change {
  color: #ff6500;
}

.filter-row {
  gap: 10rpx;
  padding: 10rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05);
}

.filter-chip {
  min-width: 118rpx;
  height: 66rpx;
  border-radius: 32rpx;
  color: #313844;
  font-size: 27rpx;
}

.filter-chip.active {
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(255, 101, 0, 0.2);
}

.note-list {
  gap: 16rpx;
}

.note-card {
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
}

.note-swipe {
  min-height: 112rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
}

.note-top {
  gap: 24rpx;
}

.check-dot {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #ff6500;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 52rpx;
}

.note-title {
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-tag {
  flex: 0 0 auto;
  max-width: 140rpx;
  overflow: hidden;
  background: #fff0e5;
  color: #ff6500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-card.done {
  opacity: 1;
}

.note-card.done .check-dot {
  border-color: #ff6500;
  background: #ff6500;
}

.note-card.done .note-swipe {
  background: linear-gradient(90deg, rgba(255, 122, 0, 0.08) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.notes-page {
  background:
    radial-gradient(circle at 84% 6%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 230rpx),
    radial-gradient(circle at 72% 20%, rgba(255, 122, 0, 0.055) 0, rgba(255, 122, 0, 0) 220rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.notes-page .memo-brand {
  display: none !important;
}
