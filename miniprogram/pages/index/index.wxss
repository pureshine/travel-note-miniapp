.home-page {
  background: linear-gradient(180deg, #eef8f5 0%, #f7faf8 42%);
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 300rpx;
  padding: 42rpx 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #17352f 0%, #167c70 58%, #d4b16a 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(22, 124, 112, 0.2);
}

.eyebrow {
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 800;
}

.hero-subtitle {
  max-width: 430rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-action {
  flex: 0 0 128rpx;
  height: 88rpx;
  align-self: flex-start;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #167c70;
  font-weight: 800;
}

.trip-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 24rpx;
  margin-top: 22rpx;
}

.trip-name {
  color: #172521;
  font-size: 32rpx;
  font-weight: 800;
}

.trip-date {
  margin-top: 12rpx;
  color: #7b8984;
  font-size: 24rpx;
}

.strip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #eef8f5;
  color: #167c70;
  font-size: 24rpx;
  font-weight: 700;
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.module-card {
  display: block;
  min-height: 210rpx;
  padding: 30rpx;
  text-align: left;
}

.module-card.schedule {
  background: linear-gradient(135deg, #ffffff 0%, #eef8f5 100%);
}

.module-card.memo {
  background: linear-gradient(135deg, #ffffff 0%, #f5f8ff 100%);
}

.module-card.expense {
  background: linear-gradient(135deg, #ffffff 0%, #fff8ed 100%);
}

.module-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.module-index {
  color: #96a39e;
  font-size: 24rpx;
  font-weight: 800;
}

.module-metric {
  color: #167c70;
  font-size: 28rpx;
  font-weight: 850;
}

.module-title {
  color: #172521;
  font-size: 38rpx;
  font-weight: 850;
}

.module-desc {
  margin-top: 14rpx;
  color: #60706a;
  font-size: 26rpx;
  line-height: 1.55;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}

.home-page {
  background:
    radial-gradient(circle at 84% 6%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 230rpx),
    radial-gradient(circle at 72% 20%, rgba(255, 122, 0, 0.055) 0, rgba(255, 122, 0, 0) 220rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.home-page .hero-title {
  display: none !important;
}
