@import "../../styles/form-base.wxss";

.trip-budget-panel {
  margin-top: 28rpx;
  padding: 32rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 211, 178, 0.95);
  border-radius: 44rpx;
  background:
    radial-gradient(circle at 96% 4%, rgba(255, 122, 0, 0.12) 0, rgba(255, 122, 0, 0) 240rpx),
    linear-gradient(180deg, #fff8f2 0%, #ffffff 62%);
}

.trip-budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.trip-budget-wrap {
  min-width: 0;
}

.trip-budget-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 0;
}

.trip-budget-subtitle {
  max-width: none;
  margin-top: 14rpx;
  color: #7b8494;
  font-size: 26rpx;
  line-height: 1.35;
}

.trip-budget-switch {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: flex-start;
  width: 88rpx;
  height: 52rpx;
  margin: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #e8edf5;
}

.trip-budget-switch.is-on {
  justify-content: flex-end;
  background: #ffe7d8;
}

.trip-budget-knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #9aa3b2;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.14);
}

.trip-budget-switch.is-on .trip-budget-knob {
  background: #ff6500;
  box-shadow: 0 10rpx 24rpx rgba(255, 101, 0, 0.25);
}

.trip-budget-body {
  margin-top: 28rpx;
}

.trip-budget-input {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 132rpx;
  padding: 24rpx 30rpx;
  border: 0;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow:
    0 20rpx 52rpx rgba(255, 122, 0, 0.08),
    inset 0 0 0 2rpx rgba(255, 221, 198, 0.92);
}

.trip-budget-yuan {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: #fff0e7;
  color: #ff6500;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.trip-budget-main {
  flex: 1;
  min-width: 0;
}

.trip-budget-label {
  display: block;
  color: #9aa3b2;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
}

.trip-budget-amount {
  width: 100%;
  min-height: 0;
  height: 58rpx;
  margin-top: 10rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #101828;
  font-size: 46rpx;
  font-weight: 950;
  line-height: 1.05;
}

.trip-budget-presets {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.trip-budget-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 24rpx;
  background: #f2f5f9;
  color: #707a8b;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1;
}

.trip-budget-chip::after {
  border: 0;
}

.trip-budget-chip.is-on {
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  box-shadow: 0 20rpx 40rpx rgba(255, 101, 0, 0.2);
}

.form-page .primary-button {
  width: 100%;
  min-height: 92rpx;
  margin: 32rpx 0 0;
  border-radius: var(--radius-button);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  box-shadow: var(--shadow-button);
}
