@import "../../styles/tab/stats-ledger.wxss";

/* Layout skeleton — budget hero / ledger polish in stats-ledger.wxss */

.daily-chart {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
  align-items: end;
  height: 172rpx;
  margin-top: 14rpx;
  padding: 0 2rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.bar-amount {
  min-height: 24rpx;
  color: #8f8171;
  font-size: 17rpx;
  font-weight: 850;
  line-height: 24rpx;
  white-space: nowrap;
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 32rpx;
  height: 90rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(120, 200, 189, 0.12);
}

.bar-fill {
  width: 100%;
  min-height: 8rpx;
  border-radius: 999rpx;
  background: #8bd2c7;
}

.bar-item.active .bar-fill {
  background: #ff9d6a;
}

.bar-label {
  color: #a79a8b;
  font-size: 18rpx;
  font-weight: 750;
  white-space: nowrap;
}

.calendar-card {
  padding: 26rpx;
  margin-top: 22rpx;
}

.calendar-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.calendar-title {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #fffaf3;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
  white-space: nowrap;
}

.month-control {
  display: grid;
  grid-template-columns: 48rpx minmax(190rpx, 1fr) 48rpx;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
}

.month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #fff0c8;
  color: #bf7a28;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.month-arrow::after {
  border: 0;
}

.month-picker {
  min-width: 0;
}

.calendar-sub {
  margin-top: 8rpx;
  color: #a79a8b;
  font-size: 22rpx;
  font-weight: 750;
}

.calendar-total {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4df;
  color: #d97949;
  font-size: 22rpx;
  font-weight: 850;
}

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
}

.week-row {
  margin-bottom: 10rpx;
  color: #c0b4a7;
  font-size: 20rpx;
  font-weight: 850;
  text-align: center;
}

.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 78rpx;
  border-radius: 22rpx;
  background: #f7fbf8;
  color: #5f554b;
}

.calendar-day.muted {
  opacity: 0.32;
}

.calendar-day.has-amount {
  background: #e7f6f2;
}

.calendar-day.high {
  background: #bdebe5;
}

.calendar-day.today {
  box-shadow: inset 0 0 0 3rpx rgba(120, 200, 189, 0.42);
}

.calendar-day.selected {
  background: #ffb98e;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(255, 138, 76, 0.18);
}

.day-number {
  font-size: 24rpx;
  font-weight: 900;
}

.day-amount {
  min-height: 22rpx;
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 800;
}

.month-trend {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(240, 223, 202, 0.72);
}

.trend-title {
  color: #2f2f2a;
  font-size: 25rpx;
  font-weight: 900;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-meta {
  color: #a79a8b;
  font-size: 24rpx;
  font-weight: 800;
}

.recent-card {
  display: grid;
  grid-template-columns: 62rpx minmax(0, 1fr) 104rpx 112rpx;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
}

.recent-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #fff1df;
  color: #e66d35;
  font-size: 19rpx;
  font-weight: 850;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  overflow: hidden;
  margin-bottom: 8rpx;
  color: #2f2f2a;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-amount {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: stretch;
  color: #2f2f2a;
  font-size: 27rpx;
  font-weight: 900;
  white-space: nowrap;
}

.recent-meta {
  color: #a79a8b;
  font-size: 22rpx;
}

.recent-tools {
  display: flex;
  gap: 8rpx;
  justify-content: flex-end;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: #fff1df;
  color: #e66d35;
  font-size: 20rpx;
  font-weight: 850;
}

.tool-button.danger {
  background: #fff0ee;
  color: #e35f4f;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.category-chip {
  padding: 16rpx;
  border-radius: 26rpx;
}

.chip-head {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  color: #a79a8b;
  font-size: 20rpx;
  font-weight: 800;
}

.chip-amount {
  margin-top: 8rpx;
  color: #2f2f2a;
  font-size: 24rpx;
  font-weight: 850;
}
