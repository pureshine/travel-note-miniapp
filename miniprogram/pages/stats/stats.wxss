.stats-page {
  background: #fff8ef;
}

.plan-switch {
  padding: 18rpx;
  margin-bottom: 22rpx;
}

.plan-picker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: #fff8ef;
}

.plan-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff8a4c;
  box-shadow: 0 0 0 8rpx rgba(255, 138, 76, 0.14);
}

.plan-copy {
  flex: 1;
  min-width: 0;
}

.plan-label {
  color: #b5a696;
  font-size: 20rpx;
  font-weight: 800;
}

.plan-name {
  margin-top: 6rpx;
  overflow: hidden;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-change {
  color: #ff8a4c;
  font-size: 23rpx;
  font-weight: 850;
  white-space: nowrap;
}

.daily-chart {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
  align-items: end;
  height: 172rpx;
  margin-top: 14rpx;
  padding: 0 2rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.bar-amount {
  min-height: 24rpx;
  color: #8f8171;
  font-size: 17rpx;
  font-weight: 850;
  line-height: 24rpx;
  white-space: nowrap;
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 32rpx;
  height: 90rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(120, 200, 189, 0.12);
}

.bar-fill {
  width: 100%;
  min-height: 8rpx;
  border-radius: 999rpx;
  background: #8bd2c7;
}

.bar-item.active .bar-fill {
  background: #ff9d6a;
}

.bar-label {
  color: #a79a8b;
  font-size: 18rpx;
  font-weight: 750;
  white-space: nowrap;
}

.calendar-card {
  padding: 26rpx;
  margin-top: 22rpx;
}

.calendar-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.calendar-title {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #fffaf3;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
  white-space: nowrap;
}

.month-control {
  display: grid;
  grid-template-columns: 48rpx minmax(190rpx, 1fr) 48rpx;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
}

.month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #fff0c8;
  color: #bf7a28;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.month-arrow::after {
  border: 0;
}

.month-picker {
  min-width: 0;
}

.calendar-sub {
  margin-top: 8rpx;
  color: #a79a8b;
  font-size: 22rpx;
  font-weight: 750;
}

.calendar-total {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4df;
  color: #d97949;
  font-size: 22rpx;
  font-weight: 850;
}

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
}

.week-row {
  margin-bottom: 10rpx;
  color: #c0b4a7;
  font-size: 20rpx;
  font-weight: 850;
  text-align: center;
}

.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 78rpx;
  border-radius: 22rpx;
  background: #f7fbf8;
  color: #5f554b;
}

.calendar-day.muted {
  opacity: 0.32;
}

.calendar-day.has-amount {
  background: #e7f6f2;
}

.calendar-day.high {
  background: #bdebe5;
}

.calendar-day.today {
  box-shadow: inset 0 0 0 3rpx rgba(120, 200, 189, 0.42);
}

.calendar-day.selected {
  background: #ffb98e;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(255, 138, 76, 0.18);
}

.day-number {
  font-size: 24rpx;
  font-weight: 900;
}

.day-amount {
  min-height: 22rpx;
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 800;
}

.month-trend {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(240, 223, 202, 0.72);
}

.trend-title {
  color: #2f2f2a;
  font-size: 25rpx;
  font-weight: 900;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-meta {
  color: #a79a8b;
  font-size: 24rpx;
  font-weight: 800;
}

.recent-card {
  display: grid;
  grid-template-columns: 62rpx minmax(0, 1fr) 104rpx 112rpx;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
}

.recent-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #fff1df;
  color: #e66d35;
  font-size: 19rpx;
  font-weight: 850;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  overflow: hidden;
  margin-bottom: 8rpx;
  color: #2f2f2a;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-amount {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: stretch;
  color: #2f2f2a;
  font-size: 27rpx;
  font-weight: 900;
  white-space: nowrap;
}

.recent-meta {
  color: #a79a8b;
  font-size: 22rpx;
}

.recent-tools {
  display: flex;
  gap: 8rpx;
  justify-content: flex-end;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: #fff1df;
  color: #e66d35;
  font-size: 20rpx;
  font-weight: 850;
}

.tool-button.danger {
  background: #fff0ee;
  color: #e35f4f;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.category-chip {
  padding: 16rpx;
  border-radius: 26rpx;
}

.chip-head {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  color: #a79a8b;
  font-size: 20rpx;
  font-weight: 800;
}

.chip-amount {
  margin-top: 8rpx;
  color: #2f2f2a;
  font-size: 24rpx;
  font-weight: 850;
}

/* Stats page refresh */
.stats-page {
  position: relative;
  background:
    radial-gradient(
      circle at 84% 6%,
      rgba(255, 255, 255, 0.96) 0,
      rgba(255, 255, 255, 0) 230rpx
    ),
    radial-gradient(
      circle at 72% 20%,
      rgba(255, 122, 0, 0.055) 0,
      rgba(255, 122, 0, 0) 220rpx
    ),
    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.stats-page .brand-row {
  display: none !important;
}

.ledger-hero {
  margin-top: 8rpx;
  padding: 0;
  overflow: visible;
  background: transparent;
}

.budget-panel,
.calendar-card,
.recent-card,
.category-chip {
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 48rpx rgba(255, 122, 0, 0.05);
}

.budget-panel {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 300rpx;
  padding: 38rpx 196rpx 38rpx 34rpx;
  overflow: visible;
  background:
    radial-gradient(
      circle at 92% 58%,
      rgba(255, 171, 77, 0.18) 0,
      rgba(255, 171, 77, 0) 220rpx
    ),
    linear-gradient(180deg, #ffffff 0%, #fffdf9 100%);
}

.budget-left {
  flex: 1;
  min-width: 0;
}

.budget-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.budget-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff6500;
}

.spend-total {
  margin-top: 18rpx;
  color: #111827;
  font-size: 64rpx;
  font-weight: 950;
  line-height: 1;
  letter-spacing: -1rpx;
}

.spend-sub {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 650;
}

.budget-split {
  width: 100%;
  height: 0;
  margin: 28rpx 0 22rpx;
  border-top: 2rpx dashed rgba(17, 24, 39, 0.14);
}

.remain-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.remain-total {
  color: #ff6500;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1;
}

.remain-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 74rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 800;
  background: #f3f4f6;
}

.ring-box {
  position: absolute;
  right: 152rpx;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
}

.budget-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
}

.ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ffffff;
}

.ring-value {
  color: #ff6500;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1;
}

.ring-label {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.budget-duck {
  position: absolute;
  right: -8rpx;
  bottom: -18rpx;
  z-index: 3;
  width: 168rpx;
  height: 324rpx;
  pointer-events: none;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hero-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  padding: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  box-shadow: 0 14rpx 28rpx rgba(255, 101, 0, 0.2);
}

.hero-add::after,
.budget-set::after {
  border: 0;
}

.budget-set {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 188rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 72rpx;
  background: #fff0e5;
  box-shadow: inset 0 0 0 1rpx rgba(255, 101, 0, 0.12);
}

.calendar-card {
  padding: 26rpx 24rpx;
}

.calendar-title {
  background: transparent;
  color: #111827;
  font-size: 31rpx;
}

.month-arrow {
  background: #f8fafc;
  color: #111827;
}

.calendar-total {
  color: #ff6500;
  background: #fff0e5;
}

.calendar-day {
  height: 82rpx;
  border-radius: 20rpx;
  background: transparent;
}

.calendar-day.has-amount,
.calendar-day.high {
  background: #fff7f0;
}

.calendar-day.selected {
  background: linear-gradient(180deg, #ff8a1f 0%, #ff6500 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 101, 0, 0.22);
}

.month-trend {
  display: none;
}

.recent-card {
  grid-template-columns: 66rpx minmax(0, 1fr) minmax(82rpx, auto) 108rpx;
  min-height: 96rpx;
  padding: 20rpx;
  border-radius: 30rpx;
}

.recent-icon {
  background: #fff0e5;
  color: #ff6500;
}

.recent-title {
  color: #111827;
  font-size: 27rpx;
  font-weight: 900;
}

.recent-amount {
  color: #111827;
}

.recent-meta,
.chip-head {
  color: #7d8593;
}

.chip-amount {
  color: #111827;
}

.tool-button {
  background: #fff0e5;
  color: #ff6500;
}

.category-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 340px) {
  .budget-panel {
