.budget-page {
  background: #fff8ef;
}

.form-title {
  color: #2f2f2a;
  font-size: 46rpx;
  font-weight: 900;
}

.form-subtitle {
  margin-top: 12rpx;
  color: #a79a8b;
  font-size: 26rpx;
  font-weight: 750;
}

.budget-card {
  padding: 34rpx 28rpx;
  margin-top: 28rpx;
  background: linear-gradient(135deg, #fffaf3 0%, #fff4e8 58%, #eef8ed 100%);
}

.paw-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 26rpx;
  background: #fff6df;
}

.paw {
  width: 48rpx;
  height: 48rpx;
}

.budget-label {
  margin-top: 24rpx;
  color: #a79a8b;
  font-size: 24rpx;
  font-weight: 850;
}

.budget-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
  color: #2f2f2a;
  font-size: 58rpx;
  font-weight: 900;
}

.budget-input {
  flex: 1;
  min-width: 0;
  height: 90rpx;
  color: #2f2f2a;
  font-size: 58rpx;
  font-weight: 900;
}

.preset-card {
  padding: 26rpx;
  margin-top: 24rpx;
}

.preset-title {
  color: #2f2f2a;
  font-size: 30rpx;
  font-weight: 900;
}

.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.preset-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0;
  border-radius: 22rpx;
  background: #fff4df;
  color: #d97949;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 64rpx;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 28rpx;
  border-radius: 30rpx;
  background: #ff8a4c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 86rpx;
  box-shadow: 0 14rpx 28rpx rgba(255, 126, 75, 0.18);
}

.preset-button::after,
.save-button::after {
  border: 0;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}
