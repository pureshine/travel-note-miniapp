/* Profile edit — single source (compact one-screen layout). */

.profile-edit-page {
  position: relative;
  min-height: 100vh;
  padding: 22rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% 8%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f7fa 48%, #eef4fb 100%);
}

.edit-bg-peak {
  position: absolute;
  top: 58rpx;
  right: -110rpx;
  width: 520rpx;
  height: 320rpx;
  opacity: 0.9;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 48% 100%, rgba(196, 207, 222, 0.2) 0, rgba(196, 207, 222, 0.2) 48%, rgba(196, 207, 222, 0) 49%),
    radial-gradient(ellipse at 82% 96%, rgba(219, 226, 236, 0.42) 0, rgba(219, 226, 236, 0.42) 56%, rgba(219, 226, 236, 0) 57%);
  filter: blur(1rpx);
}

.profile-edit-page .profile-card {
  position: relative;
  min-height: 286rpx;
  padding: 30rpx 32rpx 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 78% 30%, rgba(255, 255, 255, 0.86) 0, rgba(255, 255, 255, 0) 130rpx),
    linear-gradient(135deg, rgba(255, 246, 236, 0.96) 0%, rgba(255, 255, 255, 0.96) 50%, rgba(241, 246, 252, 0.96) 100%);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 18rpx 58rpx rgba(17, 24, 39, 0.045);
}

.profile-edit-page .profile-card::before {
  position: absolute;
  right: -120rpx;
  bottom: -112rpx;
  width: 430rpx;
  height: 210rpx;
  border-radius: 58% 42% 0 0;
  opacity: 0.68;
  background:
    radial-gradient(ellipse at 54% 100%, rgba(197, 208, 222, 0.18) 0, rgba(197, 208, 222, 0.18) 48%, rgba(197, 208, 222, 0) 49%),
    radial-gradient(ellipse at 82% 98%, rgba(216, 224, 235, 0.38) 0, rgba(216, 224, 235, 0.38) 56%, rgba(216, 224, 235, 0) 57%);
  content: "";
}

.profile-edit-page .profile-card-duck {
  display: none;
}

.profile-edit-page .avatar-picker {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 50% 28%, #ffffff 0, #ffffff 40%, #fff4e7 100%);
  color: #f0753d;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 132rpx;
  box-shadow:
    0 12rpx 28rpx rgba(17, 24, 39, 0.06),
    0 18rpx 42rpx rgba(255, 122, 0, 0.08);
}

.profile-edit-page .avatar-picker::after,
.profile-edit-page .save-button::after,
.profile-edit-page .logout-text::after {
  border: 0;
}

.profile-edit-page .avatar-image {
  width: 100%;
  height: 100%;
  background: transparent;
}

.profile-edit-page .profile-title {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.15;
}

.profile-edit-page .profile-subtitle {
  position: relative;
  z-index: 2;
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #7d8593;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
}

.profile-edit-page .form-card {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  padding: 28rpx 28rpx 22rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 8rpx 30rpx rgba(17, 24, 39, 0.035),
    0 16rpx 54rpx rgba(17, 24, 39, 0.035);
}

.profile-edit-page .field-label {
  color: #7d8593;
  font-size: 25rpx;
  font-weight: 750;
}

.profile-edit-page .name-input {
  height: 84rpx;
  margin-top: 14rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e4eaf2;
  border-radius: 28rpx;
  background: #ffffff;
  color: #111827;
  font-size: 30rpx;
  font-weight: 750;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.profile-edit-page .info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 72rpx;
  margin-top: 0;
  border-bottom: 1rpx solid #edf0f5;
  color: #8b95a4;
  font-size: 24rpx;
  font-weight: 650;
}

.profile-edit-page .name-input + .info-row {
  margin-top: 18rpx;
}

.profile-edit-page .info-row:last-child {
  border-bottom: 0;
}

.profile-edit-page .info-row text:last-child {
  overflow: hidden;
  color: #4b5563;
  font-weight: 750;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-edit-page .save-button {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 396rpx;
  height: 82rpx;
  min-height: 82rpx;
  margin: 26rpx auto 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ff9319 0%, #ff6500 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 82rpx;
  box-shadow:
    0 16rpx 32rpx rgba(255, 101, 0, 0.22),
    0 24rpx 58rpx rgba(255, 101, 0, 0.12);
}

.profile-edit-page .logout-text {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 62rpx;
  min-height: 62rpx;
  margin: 10rpx auto 0;
  color: #8f7b6a;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 62rpx;
  background: transparent;
}

@media (max-width: 340px) {
  .profile-edit-page {
    padding-top: 16rpx;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .profile-edit-page .profile-card {
    min-height: 258rpx;
    padding-top: 24rpx;
    padding-bottom: 24rpx;
  }

  .profile-edit-page .avatar-picker {
    width: 116rpx;
    height: 116rpx;
    border-radius: 30rpx;
    line-height: 116rpx;
  }

  .profile-edit-page .profile-title {
    margin-top: 16rpx;
    font-size: 34rpx;
  }

  .profile-edit-page .profile-subtitle {
    font-size: 21rpx;
  }

  .profile-edit-page .form-card {
    margin-top: 18rpx;
    padding: 24rpx 24rpx 18rpx;
  }

  .profile-edit-page .name-input {
    height: 76rpx;
  }

  .profile-edit-page .info-row {
    min-height: 64rpx;
    font-size: 22rpx;
  }

  .profile-edit-page .save-button {
    width: 340rpx;
    height: 76rpx;
    min-height: 76rpx;
    margin-top: 20rpx;
    line-height: 76rpx;
  }

  .profile-edit-page .logout-text {
    height: 56rpx;
    min-height: 56rpx;
    line-height: 56rpx;
  }
}
