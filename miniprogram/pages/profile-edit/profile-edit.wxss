.profile-edit-page {
  background: #fff8ef;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 28rpx 34rpx;
  background: linear-gradient(135deg, #ffe6bf 0%, #fff6df 58%, #edf7e9 100%);
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  padding: 0;
  overflow: hidden;
  border: 8rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 34rpx;
  background: #ffffff;
  color: #f0753d;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 150rpx;
  box-shadow: 0 14rpx 32rpx rgba(139, 93, 54, 0.12);
}

.avatar-picker::after,
.save-button::after,
.logout-text::after {
  border: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.profile-title {
  margin-top: 22rpx;
  color: #2f2f2a;
  font-size: 38rpx;
  font-weight: 900;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: #8f8171;
  font-size: 24rpx;
  font-weight: 700;
}

.form-card {
  padding: 26rpx;
  margin-top: 24rpx;
}

.field-label {
  color: #8f8171;
  font-size: 24rpx;
  font-weight: 850;
}

.name-input {
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #fff8ef;
  color: #2f2f2a;
  font-size: 30rpx;
  font-weight: 850;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 68rpx;
  margin-top: 16rpx;
  color: #9b8d7c;
  font-size: 24rpx;
  font-weight: 750;
}

.info-row text:last-child {
  overflow: hidden;
  color: #5f554b;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 28rpx;
  border-radius: 30rpx;
  background: #ff8a4c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 86rpx;
  box-shadow: 0 14rpx 28rpx rgba(255, 126, 75, 0.18);
}

.logout-text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 12rpx;
  color: #a07f63;
  font-size: 24rpx;
  font-weight: 850;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}

/* Profile edit premium refresh: match the current duck travel visual system. */
.profile-edit-page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 8%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #fbfdff 0%, #f5f7fa 48%, #eef4fb 100%) !important;
  box-sizing: border-box;
}

.profile-edit-bg-mountain {
  position: absolute;
  right: -110rpx;
  top: 58rpx;
  width: 520rpx;
  height: 320rpx;
  opacity: 0.9;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 48% 100%, rgba(196, 207, 222, 0.2) 0, rgba(196, 207, 222, 0.2) 48%, rgba(196, 207, 222, 0) 49%),
    radial-gradient(ellipse at 82% 96%, rgba(219, 226, 236, 0.42) 0, rgba(219, 226, 236, 0.42) 56%, rgba(219, 226, 236, 0) 57%);
  filter: blur(1rpx);
}

.profile-edit-page .profile-card {
  position: relative;
  min-height: 400rpx;
  padding: 44rpx 34rpx 38rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 38rpx !important;
  background:
    radial-gradient(circle at 78% 30%, rgba(255, 255, 255, 0.86) 0, rgba(255, 255, 255, 0) 130rpx),
    linear-gradient(135deg, rgba(255, 246, 236, 0.96) 0%, rgba(255, 255, 255, 0.96) 50%, rgba(241, 246, 252, 0.96) 100%) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 18rpx 58rpx rgba(17, 24, 39, 0.045) !important;
  box-sizing: border-box;
}

.profile-edit-page .profile-card::before {
  position: absolute;
  right: -90rpx;
  bottom: -76rpx;
  width: 430rpx;
  height: 210rpx;
  border-radius: 58% 42% 0 0;
  background:
    radial-gradient(ellipse at 54% 100%, rgba(197, 208, 222, 0.18) 0, rgba(197, 208, 222, 0.18) 48%, rgba(197, 208, 222, 0) 49%),
    radial-gradient(ellipse at 82% 98%, rgba(216, 224, 235, 0.38) 0, rgba(216, 224, 235, 0.38) 56%, rgba(216, 224, 235, 0) 57%);
  content: "";
}

.profile-edit-page .profile-card-duck {
  position: absolute;
  left: -34rpx;
  bottom: -10rpx;
  width: 250rpx;
  height: 270rpx;
  opacity: 0.98;
  pointer-events: none;
}

