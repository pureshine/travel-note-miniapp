.detail-page {
  background: linear-gradient(180deg, #f0f7f4 0%, #f7faf8 36%);
}

.cover {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 230rpx;
  padding: 34rpx;
  overflow: hidden;
}

.cover.mint {
  background: linear-gradient(135deg, #ffffff 0%, #effaf6 100%);
}

.cover.sky {
  background: linear-gradient(135deg, #ffffff 0%, #eef8ff 100%);
}

.cover.sunrise {
  background: linear-gradient(135deg, #ffffff 0%, #fff6e6 100%);
}

.cover-destination {
  color: #167c70;
  font-size: 26rpx;
  font-weight: 800;
}

.cover-title {
  margin-top: 16rpx;
  color: #172521;
  font-size: 46rpx;
  font-weight: 850;
}

.cover-date {
  margin-top: 14rpx;
  color: #7b8984;
  font-size: 24rpx;
}

.cover-badge {
  min-width: 96rpx;
  padding: 18rpx 20rpx;
  border-radius: 999rpx;
  background: #167c70;
  color: #ffffff;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.cover-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.cover-actions {
  display: flex;
  gap: 12rpx;
}

.cover-action {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #eef5ff;
  color: #3b82f6;
  font-size: 23rpx;
  font-weight: 800;
}

.cover-action.danger {
  background: #fef2f2;
  color: #dc2626;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.module {
  min-height: 144rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}

.module-value {
  display: block;
  color: #172521;
  font-size: 38rpx;
  font-weight: 850;
}

.module-label {
  display: block;
  margin-top: 10rpx;
  color: #7b8984;
  font-size: 24rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 22rpx;
}

.form-row {
  display: flex;
  gap: 18rpx;
}

.small-field {
  width: 190rpx;
  flex: 0 0 190rpx;
}

.timeline {
  padding: 8rpx 24rpx;
}

.timeline-row {
  display: flex;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf2ef;
}

.timeline-row:last-child {
  border-bottom: 0;
}

.time {
  width: 92rpx;
  color: #167c70;
  font-size: 26rpx;
  font-weight: 800;
}

.timeline-content {
  position: relative;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  border-radius: 18rpx;
}

.schedule-swipe {
  position: relative;
  z-index: 1;
  min-height: 76rpx;
  background: #ffffff;
  transition: transform 0.18s ease;
}

.schedule-swipe.open {
  transform: translateX(-220rpx);
}

.schedule-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: grid;
  grid-template-columns: repeat(2, 110rpx);
  width: 220rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 850;
}

.swipe-action.edit {
  background: #3b82f6;
}

.swipe-action.danger {
  background: #dc2626;
}

.schedule-title {
  color: #172521;
  font-size: 30rpx;
  font-weight: 750;
}

.schedule-place {
  margin-top: 8rpx;
  color: #7b8984;
  font-size: 24rpx;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}
