@import "../../styles/tab/profile-dashboard.wxss";

/* Hero / invite layout skeleton — do not drop during polish merges */

.pf-record-copy {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.pf-record-num {
  transform: translateY(-1rpx);
}

.pf-topline {
  position: relative;
  z-index: 3;
}

.pf-avatar,
.pf-mark {
  flex: 0 0 1rpx;
  width: 1rpx;
  min-width: 1rpx;
  max-width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.pf-avatar-img,
.pf-avatar-ph,
.pf-mark-img {
  width: 1rpx;
  height: 1rpx;
}

/* Setup sheet — page polish lives in profile-dashboard.wxss */

.pf-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 36rpx;
  background: rgba(52, 39, 26, 0.28);
}

.pf-sheet {
  width: 100%;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 36rpx;
  background: #fffaf3;
  box-shadow: 0 24rpx 60rpx rgba(86, 61, 39, 0.18);
}

.pf-sheet-title {
  color: #2f2f2a;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.pf-sheet-sub {
  margin-top: 8rpx;
  color: #8f8171;
  font-size: 24rpx;
  text-align: center;
}

.pf-setup-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 28rpx auto 22rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background: #fff1cf;
  color: #e66d35;
  font-size: 24rpx;
  font-weight: 900;
}

.pf-setup-avatar::after,
.pf-setup-save::after,
.pf-setup-skip::after {
  border: 0;
}

.pf-setup-pic {
  width: 100%;
  height: 100%;
}

.pf-setup-name {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 800;
}

.pf-setup-save {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 28rpx;
  background: #ff8a4c;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.pf-setup-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  margin-top: 10rpx;
  color: #a07f63;
  font-size: 24rpx;
  font-weight: 800;
}
