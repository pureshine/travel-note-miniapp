@import "../../styles/tab/profile-dashboard.wxss";

/* Setup sheet — page polish lives in profile-dashboard.wxss */

.profile-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 36rpx;
  background: rgba(52, 39, 26, 0.28);
}

.profile-sheet {
  width: 100%;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 36rpx;
  background: #fffaf3;
  box-shadow: 0 24rpx 60rpx rgba(86, 61, 39, 0.18);
}

.sheet-title {
  color: #2f2f2a;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.sheet-subtitle {
  margin-top: 8rpx;
  color: #8f8171;
  font-size: 24rpx;
  text-align: center;
}

.setup-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 28rpx auto 22rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background: #fff1cf;
  color: #e66d35;
  font-size: 24rpx;
  font-weight: 900;
}

.setup-avatar::after,
.setup-save::after,
.setup-skip::after {
  border: 0;
}

.setup-avatar-image {
  width: 100%;
  height: 100%;
}

.setup-nickname {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  color: #2f2f2a;
  font-size: 28rpx;
  font-weight: 800;
}

.setup-save {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 28rpx;
  background: #ff8a4c;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.setup-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  margin-top: 10rpx;
  color: #a07f63;
  font-size: 24rpx;
  font-weight: 800;
}
