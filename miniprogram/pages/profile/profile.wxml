<view class="page pf-page" style="{{safeTopStyle}}">
  <brand-nav customNavStyle="{{customNavStyle}}" nav-class="pf-nav" logo-class="pf-nav-logo" />
  <view class="pf-hero {{loggedIn ? '' : 'is-guest'}}">
    <image class="pf-hero-duck" src="/assets/design3d/profile-duck-camera-full.png" mode="aspectFit" />
    <view class="pf-topline" bindtap="openProfileEdit">
      <view wx:if="{{loggedIn}}" class="pf-avatar">
        <image wx:if="{{avatarUrl}}" class="pf-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <image wx:else class="pf-avatar-ph" src="/assets/illustrations/duck-avatar.png" mode="aspectFit" />
      </view>
      <view wx:else class="pf-mark">
        <image class="pf-mark-img" src="/assets/illustrations/duck-avatar.png" mode="aspectFit" />
      </view>
      <view class="pf-copy {{loggedIn ? '' : 'is-guest'}}">
        <view wx:if="{{loggedIn}}" class="pf-name-row">
          <view class="pf-name">{{nickname}}</view>
        </view>
        <view wx:else class="pf-login-box">
          <view class="pf-login-wrap">
            <view class="pf-login-face">
              <view class="pf-login-ico">微</view>
              <text class="pf-login-text">微信一键登录</text>
            </view>
            <button
              class="pf-login-hit"
              loading="{{syncing}}"
              catchtap="loginWithWechat"
              hover-class="none"
              aria-label="微信一键登录"
            />
          </view>
        </view>
        <view class="pf-location">
          <text class="pf-loc-icon">●</text>
          <text>探索世界的每个角落</text>
        </view>
        <view class="pf-record-pill">
          <view class="pf-record-star">★</view>
          <view class="pf-record-copy">
            <view class="pf-record-text">已记录</view>
            <view class="pf-record-num">{{tripCount}}</view>
            <view class="pf-record-text">次旅行</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="pf-overview {{loggedIn ? '' : 'is-guest'}}">
    <view class="pf-stat">
      <view class="pf-stat-icon">
        <image class="pf-stat-pic" src="/assets/design3d/profile-stat-trip.png" mode="aspectFit" />
      </view>
      <view class="pf-stat-copy">
        <view class="pf-stat-val {{tripCount > 99 ? 'is-compact' : ''}}">{{tripCount}}</view>
        <view class="pf-stat-title">旅行</view>
        <view class="pf-stat-desc">已记录</view>
      </view>
    </view>
    <view class="pf-stat">
      <view class="pf-stat-icon">
        <image class="pf-stat-pic" src="/assets/design3d/profile-stat-schedule.png" mode="aspectFit" />
      </view>
      <view class="pf-stat-copy">
        <view class="pf-stat-val {{scheduleCount > 99 ? 'is-compact' : ''}}">{{scheduleCount}}</view>
        <view class="pf-stat-title">日程</view>
        <view class="pf-stat-desc">项日程</view>
      </view>
    </view>
    <view class="pf-stat is-sync">
      <view class="pf-stat-icon">
        <image class="pf-stat-pic" src="/assets/design3d/profile-stat-sync.png" mode="aspectFit" />
      </view>
      <view class="pf-stat-copy">
        <view class="pf-stat-val is-time">{{lastSyncText}}</view>
        <view class="pf-stat-title">同步</view>
        <view class="pf-stat-desc">最近同步</view>
      </view>
    </view>
  </view>

  <view class="pf-sync-card panel {{memberNamesText ? 'is-members' : ''}}">
    <image class="pf-invite-bg" src="/assets/design3d/profile-invite-scene-crop.png" mode="aspectFill" />
    <view class="pf-card-head">
      <view class="pf-card-copy">
        <view class="pf-sync-title">邀请好友一起记录</view>
        <view class="pf-sync-desc">一起探索世界，留下美好回忆</view>
        <view wx:if="{{memberNamesText}}" class="pf-member-row">
          <text class="pf-member-tag">同行</text>
          <text class="pf-member-names">{{memberNamesText}}</text>
        </view>
        <view class="pf-card-actions">
          <view
            wx:if="{{!memberNamesText && !inviteCode}}"
            class="pf-invite-btn {{inviteLoading ? 'is-busy' : ''}}"
            bindtap="createInvite"
          >{{inviteLoading ? '生成中...' : '生成邀请'}}</view>
          <view wx:if="{{inviteCode}}" class="pf-share-wrap">
            <view class="pf-share-face">分享给好友</view>
            <button class="pf-share-hit" open-type="share" hover-class="none">分享给好友</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="pf-tool-grid">
    <view class="pf-tool-card panel">
      <view class="pf-tool-icon">☁</view>
      <view class="pf-tool-title">账号数据</view>
      <view class="pf-tool-desc">换手机后登录微信即可恢复</view>
    </view>
    <view class="pf-tool-card panel">
      <view class="pf-tool-icon">✦</view>
      <view class="pf-tool-title">同行共享</view>
      <view class="pf-tool-desc">好友加入后维护同一份旅行</view>
    </view>
  </view>

  <view wx:if="{{showProfileSetup}}" class="pf-mask">
    <view class="pf-sheet">
      <view class="pf-sheet-title">设置显示名字</view>
      <view class="pf-sheet-sub">好友共享和记录人都会显示这个名字</view>
      <button class="pf-setup-avatar" open-type="chooseAvatar" bindchooseavatar="onSetupChooseAvatar">
        <image wx:if="{{draftAvatarUrl}}" class="pf-setup-pic" src="{{draftAvatarUrl}}" mode="aspectFill" />
        <text wx:else>选头像</text>
      </button>
      <input
        class="pf-setup-name"
        type="text"
        value="{{draftNickname}}"
        bindinput="onSetupNicknameInput"
        bindblur="onSetupNicknameBlur"
        placeholder="比如 小陈、阿圆、旅行搭子"
      />
      <button class="pf-setup-save" bindtap="saveProfileSetup">保存资料</button>
      <button class="pf-setup-skip" bindtap="skipProfileSetup">稍后再说</button>
    </view>
  </view>
</view>
