.brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  background: #167c70;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 850;
}

.brand-title {
  color: #172521;
  font-size: 36rpx;
  font-weight: 850;
}

.settings-list {
  overflow: hidden;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 124rpx;
  padding: 24rpx;
  text-align: left;
}

.settings-title {
  color: #172521;
  font-size: 30rpx;
  font-weight: 800;
}

.settings-desc {
  margin-top: 8rpx;
  color: #7b8984;
  font-size: 24rpx;
}

.settings-arrow {
  color: #a7b3af;
  font-size: 44rpx;
}

.roadmap {
  padding: 10rpx 24rpx;
}

.roadmap-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2ef;
  color: #24332f;
  font-size: 28rpx;
}

.roadmap-item:last-child {
  border-bottom: 0;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}
