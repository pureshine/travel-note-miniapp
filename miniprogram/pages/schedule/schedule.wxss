    linear-gradient(180deg, #fbfdff 0%, #f5f8fd 48%, #eef4fb 100%);
}

.schedule-page .brand-row {
  display: none !important;
}

/* Premium plan summary card. */
.schedule-page .tip-card {
  position: relative;
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr) 134rpx;
  align-items: center;
  gap: 18rpx;
  min-height: 168rpx;
  padding: 28rpx 30rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  background:
    radial-gradient(
      circle at 12% 50%,
      rgba(255, 122, 0, 0.14) 0,
      rgba(255, 122, 0, 0) 150rpx
    ),
    radial-gradient(
      circle at 92% 0%,
      rgba(255, 215, 122, 0.14) 0,
      rgba(255, 215, 122, 0) 170rpx
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(249, 252, 255, 0.95) 58%,
      rgba(255, 246, 237, 0.92) 100%
    );
  box-shadow:
    0 8rpx 28rpx rgba(15, 23, 42, 0.045),
    0 20rpx 58rpx rgba(255, 122, 0, 0.08);
  backdrop-filter: blur(18rpx);
}

.schedule-page .tip-icon {
  position: relative;
  z-index: 1;
  width: 108rpx;
  height: 108rpx;
  overflow: visible;
  border-radius: 32rpx;
}

.schedule-page .tip-icon-duck {
  width: 126rpx;
  height: 126rpx;
  transform: translate(-8rpx, -10rpx);
}

.schedule-page .tip-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.schedule-page .tip-title {
  max-width: 100%;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.24;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-page .tip-sub {
  max-width: 100%;
  margin-top: 8rpx;
  overflow: visible;
  color: #7d8593;
  font-size: 23rpx;
  line-height: 1.25;
  text-overflow: clip;
  white-space: nowrap;
}

.schedule-page .tip-meta {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  gap: 12rpx;
  align-items: flex-end;
  color: #7d8593;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
}

.schedule-page .tip-meta text {
  max-width: 132rpx;
  padding: 9rpx 15rpx;
  overflow: hidden;
  border-radius: 999rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-page .tip-meta text:first-child {
  color: #111827;
  background: rgba(248, 250, 252, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(226, 232, 240, 0.86);
}

.schedule-page .tip-meta text:last-child {
  color: #ff6500;
  background: rgba(255, 240, 229, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.1);
}

@media (max-width: 340px) {
  .schedule-page .tip-card {
    grid-template-columns: 86rpx minmax(0, 1fr) 118rpx;
