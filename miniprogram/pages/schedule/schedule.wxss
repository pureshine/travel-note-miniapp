    height: 78rpx;
    font-size: 27rpx;
    line-height: 78rpx;
    border-radius: 30rpx;
  }
}

/* Itinerary timeline: image-card layout matching the supplied design. */
.schedule-page .section-title {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  margin: 34rpx 0 22rpx;
}

.schedule-page .section-title text {
  color: #111827;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.2;
}

.schedule-page .timeline {
  position: relative;
  padding: 0 0 20rpx;
  overflow: visible;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.schedule-page .timeline-mascot {
  position: absolute;
  top: 70rpx;
  left: 132rpx;
  z-index: 8;
  width: 132rpx;
  height: 132rpx;
  pointer-events: none;
  transform: rotate(-3deg);
}

.schedule-page .year-group {
  position: relative;
}

.schedule-page .year-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 54rpx;
  margin: 4rpx 0 10rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ff6500;
  font-size: 28rpx;
  font-weight: 950;
  background: rgba(255, 240, 229, 0.96);
}

.schedule-page .timeline-row {
  display: grid;
  grid-template-columns: 118rpx 42rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: start;
  padding: 20rpx 0 30rpx;
}

.schedule-page .time-block {
  align-items: flex-end;
  padding-top: 8rpx;
}

.schedule-page .day {
  color: #8a93a3;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.05;
}

.schedule-page .time {
  margin-top: 8rpx;
  color: #ff6500;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.05;
}

.schedule-page .status {
  margin-top: 18rpx;
  padding: 8rpx 13rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.15;
}

.schedule-page .status.done {
  color: #23b26d;
  background: rgba(230, 250, 240, 0.98);
}

.schedule-page .status.active,
.schedule-page .status.pending {
  color: #ff6500;
  background: rgba(255, 240, 229, 0.98);
}

.schedule-page .line {
  min-height: 204rpx;
}

.schedule-page .line::after {
  top: 28rpx;
  bottom: -50rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #ff6500 0%, rgba(255, 101, 0, 0.12) 100%);
}

.schedule-page .timeline-row:last-child .line::after {
  display: none;
}

.schedule-page .dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 9rpx;
  border: 8rpx solid #ffffff;
  background: #ff6500;
  box-shadow:
    0 0 0 2rpx rgba(255, 101, 0, 0.1),
    0 8rpx 20rpx rgba(255, 101, 0, 0.18);
}

.schedule-page .event-wrap {
  overflow: visible;
  border-radius: 34rpx;
}

.schedule-page .event {
  position: relative;
  display: block;
  min-height: 164rpx;
  padding: 32rpx 34rpx;
  overflow: visible;
  border: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 8rpx 30rpx rgba(15, 23, 42, 0.045),
    0 18rpx 52rpx rgba(255, 122, 0, 0.055);
  transition: none;
}

.schedule-page .event.has-image {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  gap: 22rpx;
  align-items: center;
  min-height: 194rpx;
  padding: 28rpx;
}

.schedule-page .event.open {
  transform: none;
}

.schedule-page .event::before {
  position: absolute;
  top: 72rpx;
  left: -13rpx;
  width: 28rpx;
  height: 28rpx;
  content: "";
  background: rgba(255, 255, 255, 0.96);
  border-radius: 6rpx;
  transform: rotate(45deg);
}

.schedule-page .event-copy {
  min-width: 0;
}

.schedule-page .event-head {
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.schedule-page .category {
  padding: 8rpx 16rpx;
  color: #ff6500;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.1;
  background: rgba(255, 240, 229, 0.98);
  border-radius: 999rpx;
}

.schedule-page .place {
  color: #7d8593;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
}

.schedule-page .event-title {
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-page .event-note {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #7d8593;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.schedule-page .event-swiper {
  width: 176rpx;
  height: 142rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #eef2f7;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.08);
}

.schedule-page .event-image {
  display: block;
  width: 176rpx;
  height: 142rpx;
  margin: 0;
  border-radius: 24rpx;
  background: #eef2f7;
}

.schedule-page .event-actions,
.schedule-page .swipe-action {
  display: none !important;
}

@media (max-width: 340px) {
