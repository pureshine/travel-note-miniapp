@import "../../styles/tab/schedule-timeline.wxss";

/* Page skeleton — timeline layout structure */

.sch-time {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 0;
}

.sch-line {
  position: relative;
  z-index: 0;
  display: flex;
  justify-content: center;
}

.sch-line::after {
  content: "";
  position: absolute;
}

.sch-dot {
  position: relative;
  z-index: 0;
}

.sch-wrap {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.sch-card-head {
  display: flex;
  align-items: center;
}

.time-duck {
  position: absolute;
  top: -24rpx;
  left: 152rpx;
  z-index: 3;
  width: 156rpx;
  height: 152rpx;
  pointer-events: none;
  transform: rotate(-2deg);
}

.duck-gap {
  padding-top: 46rpx;
}

@media (max-width: 340px) {
  .time-duck {
    top: -18rpx;
    left: 122rpx;
    width: 128rpx;
    height: 124rpx;
  }

  .duck-gap {
    padding-top: 38rpx;
  }
}
