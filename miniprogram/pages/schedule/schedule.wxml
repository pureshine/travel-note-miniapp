<view class="page sch-page" style="{{safeTopStyle}}">
  <brand-nav customNavStyle="{{customNavStyle}}" />
  <view class="brand-row u-hide">
    <view class="brand-wordmark">
      <text class="brand-hot">冲鸭</text>去旅行
    </view>
  </view>

  <view class="sch-tip panel {{trip ? '' : 'sch-tip-empty'}}">
    <view wx:if="{{trip}}" class="sch-tip-icon">
      <image class="sch-tip-duck" src="/assets/design3d/schedule-plan-duck.png" mode="aspectFit" />
    </view>
    <view class="sch-tip-copy">
      <view class="sch-tip-title {{trip ? '' : 'is-tip-alt'}}">{{travelTip.title}}</view>
      <view class="sch-tip-sub {{trip ? '' : 'is-sub-alt'}}">{{travelTip.subtitle}}</view>
    </view>
    <view class="sch-tip-meta {{trip ? '' : 'is-meta-hide'}}">
      <text>{{travelTip.metaTop}}</text>
    </view>
  </view>

  <view wx:if="{{trip}}" class="sch-plan panel">
    <view class="sch-plan-main">
      <picker
        class="sch-plan-pick"
        mode="selector"
        range="{{tripOptions}}"
        value="{{activeTripIndex}}"
        bindchange="onTripChange"
      >
        <view class="sch-plan-pill">
          <view class="sch-plan-dot {{tripStatusClass}}"></view>
          <view class="sch-plan-copy">
            <view class="sch-plan-label">当前计划</view>
            <view class="sch-plan-name">{{trip.name}}</view>
          </view>
          <view class="sch-plan-ops">
            <view class="sch-plan-tail {{tripStatusClass}}">
              <view class="sch-status">{{tripStatus}}</view>
              <view class="sch-plan-more">▾</view>
            </view>
            <view class="sch-plan-menu" catchtap="manageTrip">⋮</view>
          </view>
        </view>
      </picker>
    </view>
    <button class="sch-quick-add" bindtap="goScheduleForm">+ 添加日程</button>
  </view>
  <view wx:else class="sch-plan panel">
    <view class="sch-no-card">
      <view class="sch-no-copy">
        <view class="sch-no-kicker">从一个目的地开始</view>
        <view class="sch-no-title">还没有旅行计划</view>
        <view class="sch-no-desc">新建后可添加日程、备忘和消费预算。</view>
      </view>
      <view class="sch-no-visual">
        <image class="sch-no-foot" src="/assets/illustrations/duck-foot-icon.png" mode="aspectFit" />
      </view>
    </view>
    <button class="sch-quick-add sch-quick-main" bindtap="goTripForm">+ 新建旅行</button>
    <view class="sch-no-steps">
      <view class="sch-no-step">定目的地</view>
      <view class="sch-no-step">排日程</view>
      <view class="sch-no-step">记花费</view>
    </view>
  </view>

  <view wx:if="{{trip}}" class="sch-head">
    <text>行程时间轴</text>
    <text class="sch-head-count">{{filteredSchedules.length}}/{{schedules.length}}</text>
  </view>
  <view wx:if="{{trip && schedules.length > 0}}" class="sch-filter-anchor {{filterDocked ? 'is-docked' : ''}}">
    <view class="sch-filter {{filterDocked ? 'is-fixed' : ''}}" style="{{filterDocked ? filterDockStyle : ''}}">
      <view class="sch-filter-grid">
        <view class="sch-filter-cell">
          <picker
            class="sch-filter-pick"
            mode="selector"
            range="{{dateFilterLabels}}"
            value="{{dateFilterIndex}}"
            bindchange="onDateFilterChange"
          >
            <view class="sch-filter-chip {{dateFilterIndex > 0 ? 'has-clear' : ''}}">
              <text class="sch-filter-label">日期</text>
              <text class="sch-filter-value">{{dateFilterLabels[dateFilterIndex]}}</text>
              <text wx:if="{{dateFilterIndex === 0}}" class="sch-filter-caret">▾</text>
            </view>
          </picker>
          <text
            wx:if="{{dateFilterIndex > 0}}"
            class="sch-filter-clear"
            catchtap="clearDateFilter"
          >×</text>
        </view>
        <view class="sch-filter-cell">
          <picker
            class="sch-filter-pick"
            mode="selector"
            range="{{categoryFilterOptions}}"
            value="{{categoryFilterIndex}}"
            bindchange="onCategoryFilterChange"
          >
            <view class="sch-filter-chip {{categoryFilterIndex > 0 ? 'has-clear' : ''}}">
              <text class="sch-filter-label">类型</text>
              <text class="sch-filter-value">{{categoryFilterOptions[categoryFilterIndex]}}</text>
              <text wx:if="{{categoryFilterIndex === 0}}" class="sch-filter-caret">▾</text>
            </view>
          </picker>
          <text
            wx:if="{{categoryFilterIndex > 0}}"
            class="sch-filter-clear"
            catchtap="clearCategoryFilter"
          >×</text>
        </view>
        <view class="sch-filter-cell">
          <picker
            class="sch-filter-pick"
            mode="selector"
            range="{{statusFilters}}"
            value="{{statusFilterIndex}}"
            bindchange="onStatusFilterChange"
          >
            <view class="sch-filter-chip {{statusFilterIndex > 0 ? 'has-clear' : ''}}">
              <text class="sch-filter-label">状态</text>
              <text class="sch-filter-value">{{activeStatusFilter}}</text>
              <text wx:if="{{statusFilterIndex === 0}}" class="sch-filter-caret">▾</text>
            </view>
          </picker>
          <text
            wx:if="{{statusFilterIndex > 0}}"
            class="sch-filter-clear"
            catchtap="clearStatusFilter"
          >×</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{trip}}" class="sch-board panel">
    <image
      wx:if="{{filteredSchedules.length > 0}}"
      class="time-duck"
      src="/assets/design3d/timeline-duck-right.png"
      mode="aspectFit"
    />
    <view wx:for="{{scheduleGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="year" class="sch-year">
      <view class="sch-year-tag">{{group.year}}</view>
      <view
        wx:for="{{group.items}}"
        wx:for-item="item"
        wx:for-index="itemIndex"
        wx:key="id"
        class="sch-row is-{{item.statusClass}} {{item.active ? 'is-active' : ''}} {{groupIndex === 0 && itemIndex === 0 && filteredSchedules.length > 0 ? 'duck-gap' : ''}}"
      >
        <view class="sch-time">
          <text class="sch-day">{{item.monthDay}}</text>
          <text class="sch-hour {{item.endTimeText ? 'is-range' : ''}}">{{item.timeRange}}</text>
          <text class="sch-state {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="sch-line">
          <view class="sch-dot"></view>
        </view>
        <view class="sch-wrap {{clipScheduleId === item.id ? 'is-wrap-open' : ''}}">
          <view
            class="sch-card is-{{item.statusClass}} {{item.images.length > 0 ? 'is-pic' : ''}} {{item.active ? 'is-active' : ''}} {{openScheduleId === item.id ? 'is-slide' : ''}}"
            bindtouchstart="onScheduleTouchStart"
            bindtouchmove="onScheduleTouchMove"
            data-id="{{item.id}}"
          >
            <view class="sch-card-copy">
              <view class="sch-card-head">
                <text class="sch-tag">{{item.category}}</text>
                <text class="sch-place">{{item.place}}</text>
              </view>
              <view class="sch-card-title">{{item.title}}</view>
              <view wx:if="{{item.note}}" class="sch-card-note">{{item.note}}</view>
            </view>
            <swiper
              wx:if="{{item.images.length > 0}}"
              class="sch-card-swiper"
              indicator-dots="{{item.images.length > 1}}"
              indicator-color="rgba(255,255,255,0.55)"
              indicator-active-color="#ff6500"
              circular="{{item.images.length > 1}}"
              data-id="{{item.id}}"
            >
              <swiper-item wx:for="{{item.images}}" wx:for-item="image" wx:for-index="imageIndex" wx:key="*this">
                <image
                  class="sch-card-pic"
                  src="{{image}}"
                  mode="aspectFill"
                  data-id="{{item.id}}"
                  data-index="{{imageIndex}}"
                  bindtap="previewScheduleImage"
                />
              </swiper-item>
            </swiper>
          </view>
          <view class="sch-actions {{openScheduleId === item.id ? 'is-show' : ''}}">
            <button class="sch-action is-edit" catchtap="editSchedule" data-id="{{item.id}}">编辑</button>
            <button
              class="sch-action is-danger"
              catchtap="deleteScheduleItem"
              data-id="{{item.id}}"
            >删除</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{schedules.length === 0}}" class="sch-board-empty" bindtap="goScheduleForm">
      <view class="sch-board-icon">+</view>
      <view class="sch-empty-title">还没有日程安排</view>
      <view class="sch-empty-desc">先添加一个行程，时间轴就会自动生成</view>
    </view>
    <view wx:elif="{{filteredSchedules.length === 0}}" class="sch-board-empty sch-filter-empty">
      <view class="sch-board-icon">⌕</view>
      <view class="sch-empty-title">没有符合条件的日程</view>
      <view class="sch-empty-desc">换个日期或状态看看</view>
    </view>
  </view>
</view>
