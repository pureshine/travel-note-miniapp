<form-shell wx:if="{{trip}}" title="{{formTitle}}" subtitle="{{trip.name}} · {{trip.destination}}">
  <input class="field" placeholder="消费名称，如 一兰拉面" value="{{title}}" bindinput="onTitleInput" />
  <input class="field" type="digit" placeholder="金额" value="{{amount}}" bindinput="onAmountInput" />
  <picker mode="date" value="{{date}}" bindchange="onDateChange">
    <view class="picker-field">日期：{{date}}</view>
  </picker>
  <view class="pick-box">
    <view class="pick-headline">分类</view>
    <view class="pick-list">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="pick-item {{categoryIndex === index ? 'is-on' : ''}}"
        data-index="{{index}}"
        bindtap="onCategorySelect"
      >{{item}}</view>
    </view>
  </view>
  <input class="field" placeholder="付款人" value="{{paidBy}}" bindinput="onPaidByInput" />
  <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveExpense">{{saveLabel}}</button>
</form-shell>
