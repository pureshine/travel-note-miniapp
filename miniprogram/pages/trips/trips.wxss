.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title {
  color: #172521;
  font-size: 46rpx;
  font-weight: 800;
}

.add-button {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #167c70;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 300;
}

.trip-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trip-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 132rpx;
  padding: 22rpx;
}

.trip-accent {
  width: 12rpx;
  height: 82rpx;
  border-radius: 999rpx;
}

.trip-accent.mint {
  background: #167c70;
}

.trip-accent.sky {
  background: #4d8fb8;
}

.trip-accent.sunrise {
  background: #d4a649;
}

.trip-main {
  flex: 1;
  min-width: 0;
}

.trip-name {
  overflow: hidden;
  color: #172521;
  font-size: 32rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-meta {
  margin-top: 10rpx;
  color: #7b8984;
  font-size: 24rpx;
}

.trip-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
  flex: 0 0 auto;
}

.trip-count {
  color: #167c70;
  font-size: 24rpx;
  font-weight: 700;
}

.trip-actions {
  display: flex;
  gap: 12rpx;
}

.text-action {
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #eef5ff;
  color: #3b82f6;
  font-size: 22rpx;
  font-weight: 750;
}

.text-action.danger {
  background: #fef2f2;
  color: #dc2626;
}

/* Shared design refresh: align secondary pages with the duck travel visual system. */
.form-page,
.budget-page,
.profile-edit-page,
.settings-page,
.trip-detail-page,
.index-page,
.trips-page,
.checklist-page,
.expenses-page {
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 122, 0, 0.1) 0, rgba(255, 122, 0, 0) 210rpx),
    linear-gradient(180deg, #f9fbff 0%, #f1f5fa 100%);
}

.form-title,
.page-title,
.title {
  color: #111827 !important;
  font-weight: 950 !important;
  letter-spacing: 0 !important;
}

.form-subtitle,
.page-subtitle,
.subtitle,
.desc,
.muted {
  color: #7d8593 !important;
}

.form-card,
.budget-card,
.preset-card,
.panel,
.card {
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 36rpx !important;
  background: rgba(255, 255, 255, 0.92) !important;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.03),
    0 16rpx 64rpx rgba(255, 122, 0, 0.05) !important;
}

.field,
.textarea,
.picker-field,
input,
textarea {
  border: 2rpx solid rgba(226, 232, 240, 0.88) !important;
  border-radius: 28rpx !important;
  background: #ffffff !important;
  color: #111827 !important;
}

.save-button,
.primary-button,
.submit-button,
.confirm-button {
  border-radius: 30rpx !important;
  background: linear-gradient(135deg, #ff9a1f 0%, #ff6500 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 30rpx rgba(255, 101, 0, 0.22) !important;
}

.preset-button,
.ghost-button,
.secondary-button {
  border-radius: 26rpx !important;
  background: #fff0e5 !important;
  color: #ff6500 !important;
}
