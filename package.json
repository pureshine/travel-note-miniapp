{
  "name": "travel-note-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "冲鸭去旅行微信小程序：旅行日程、清单、备忘和消费统计。",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:logic": "npm run build && node scripts/check-schedule-view.js && node scripts/check-trip-store-domains.js && node scripts/check-schedule-form-sync.js",
    "format:check": "node scripts/check-format.js",
    "style:check": "node scripts/check-styles.js",
    "lint": "node --require ./scripts/eslint-node16-polyfill.js ./node_modules/eslint/bin/eslint.js miniprogram --ext .ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.4"
  }
}
